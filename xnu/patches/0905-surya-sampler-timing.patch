sweet: sampler start delay and interval as boot-args

sweetsampledelay and sweetsampleevery (seconds) replace the fixed 90 s and
120 s, to catch a daemon in its first seconds. Defaults unchanged.
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -10,7 +10,8 @@
  * with tools/sweet-crash.py). A thread blocked in a syscall shows the
  * syscall stub in pc and its caller in lr/bt.
  *
- * First sample 90 s after start, then every 120 s, 40 samples at most.
+ * First sample 90 s after start, then every 120 s, 40 samples at most
+ * (surya: boot-args sweetsampledelay, sweetsampleevery in seconds).
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -45,12 +46,20 @@
 }
 
 extern void sweet_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+extern void sweet_sample_task_cpu(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+static int sweet_sample_top;
 
 static int
 sweet_sample_proc(proc_t p, __unused void *arg)
 {
 	char name[32];
 	proc_name(proc_pid(p), name, sizeof(name));
+	if (sweet_sample_top) {
+		task_t t = proc_task(p);
+		if (t != TASK_NULL) {
+			sweet_sample_task_cpu(name, proc_pid(p), t);
+		}
+	}
 	if (sweet_sample_wanted(name)) {
 		task_t task = proc_task(p);
 		if (task != TASK_NULL) {
@@ -64,17 +73,36 @@
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	static int chan;
+	int delay = 90, every = 120;
 	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
 		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
 	}
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	/* surya: sweetsampledelay / sweetsampleevery (seconds) move the samples
+	 * earlier, to catch a daemon right after launch; defaults unchanged. */
+	(void)PE_parse_boot_argn("sweetsampledelay", &delay, sizeof(delay));
+	(void)PE_parse_boot_argn("sweetsampleevery", &every, sizeof(every));
+	delay = delay < 1 ? 1 : delay;
+	every = every < 1 ? 1 : every;
+	/* surya 23.10: sweetsampleburst=N takes N samples 20 ms apart at every
+	 * period (with sweetsamplet0=1, osfmk/kern/exception.c, only each task's
+	 * first thread): where SpringBoard's main thread is while it scrolls. */
+	(void)PE_parse_boot_argn("sweetsampletop", &sweet_sample_top, sizeof(sweet_sample_top));
+	int burst = 1;
+	(void)PE_parse_boot_argn("sweetsampleburst", &burst, sizeof(burst));
+	burst = burst < 1 ? 1 : (burst > 200 ? 200 : burst);
+	(void)tsleep(&chan, PZERO, "sweetsmp", delay * hz);
 	for (int i = 0; i < 40; i++) {
-		printf("SMP --- sample %d\n", i);
-		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		for (int b = 0; b < burst; b++) {
+			printf("SMP --- sample %d\n", i * burst + b);
+			proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+			if (burst > 1) {
+				(void)tsleep(&chan, PZERO, "sweetsmp", hz / 50 ? hz / 50 : 1);
+			}
+		}
+		(void)tsleep(&chan, PZERO, "sweetsmp", every * hz);
 	}
 }
 
