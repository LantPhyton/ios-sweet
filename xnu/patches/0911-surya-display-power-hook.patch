+static void
+sweet_fb_stat_swap(const uint8_t *rec)
+{
+	uint32_t id = get32(rec, 0x54);
+	SweetSurface *s = id ? sweet_surface_copy(id) : NULL;
+	if (s == NULL) {
+		return;
+	}
+	uint64_t hash = 0;
+	uintptr_t base = s->kernelAddress();
+	if (base != 0 && s->memory != NULL && s->bytesPerRow >= s->width * 4 &&
+	    (uint64_t)s->offset + (uint64_t)s->height * s->bytesPerRow <= s->memory->getLength() &&
+	    s->height >= 32 && s->width >= 32) {
+		for (uint32_t i = 0; i < 32; i++) {
+			const uint32_t *row = (const uint32_t *)(base + s->offset +
+			    (uint64_t)(i * (s->height / 32)) * s->bytesPerRow);
+			for (uint32_t j = 0; j < 32; j++) {
+				hash = hash * 1000003ULL + row[j * (s->width / 32)];
+			}
+		}
+	}
+	s->release();
+	sweet_fb_stat_swaps++;
+	if (hash == sweet_fb_stat_last_hash) {
+		sweet_fb_stat_dups++;
+	}
+	sweet_fb_stat_last_hash = hash;
+}
