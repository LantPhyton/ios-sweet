+/* surya 25.10: physical memory (the panel buffers) mapped write-combined into the kernel. */
+static uintptr_t
+surya_map_phys(uint64_t phys, uint64_t len, IOMemoryMap **out)
+{
+	*out = NULL;
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(phys, len, kIODirectionInOut);
+	if (md == NULL) {
+		return 0;
+	}
+	IOMemoryMap *map = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
+	md->release();
+	if (map == NULL) {
+		return 0;
+	}
+	*out = map;
+	return (uintptr_t)map->getVirtualAddress();
+}
+
+/* surya 25.10: a MiniIOSurface as the copy reads it. */
+struct surya_surf {
+	MiniIOSurface *ms;
+	uintptr_t base;         /* kernel address of the surface's pixel memory (offset 0) */
+	uint64_t length;        /* bytes valid from base */
+	uint32_t offset, width, height, bytesPerRow, pixelFormat;
+	uint32_t bytesPerElement, elementWidth, elementHeight;
+};
+
+static bool
+surya_surf_get(uint32_t id, struct surya_surf *v)
+{
+	MiniIOSurface *ms = id ? MiniIOSurfaceCopy(id) : NULL;
+	if (ms == NULL) {
+		return false;
+	}
+	v->ms = ms;
+	v->base = (uintptr_t)ms->kpixels;
+	v->length = ms->info.allocSize;
+	v->offset = ms->info.offset;
+	v->width = ms->info.width;
+	v->height = ms->info.height;
+	v->bytesPerRow = ms->info.bytesPerRow;
+	v->pixelFormat = ms->info.pixelFormat;
+	v->bytesPerElement = ms->info.bytesPerElement;
+	v->elementWidth = ms->info.elementWidth;
+	v->elementHeight = ms->info.elementHeight;
+	if (v->base == 0) {
+		MiniIOSurfaceDrop(ms);
+		return false;
+	}
+	return true;
+}
