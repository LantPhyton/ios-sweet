+/* surya mode: copies the latest frame whenever the vsync timer asks. */
+void
+AppleCLCD::copyLoop(void)
+{
+	bool cache_reset = !surya_fb_2x;
+	for (;;) {
+		if (!cache_reset) {
+			int err = surya_fb2x_reset_cache();
+			if (err != EAGAIN) {
+				cache_reset = true;
+				IOLog("SWEET FB: @2x: MobileGestalt cache truncated (err %d)\n", err);
+			}
+		}
+		IOLockLock(fLock);
+		while (!fCopyWanted) {
+			(void)IOLockSleep(fLock, &fCopyWanted, THREAD_UNINT);
+		}
+		fCopyWanted = false;
+		memcpy(fCopyRec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		IOLockUnlock(fLock);
+		int line_start = -1, line_wait = -1;
+		uint64_t t_wait0 = 0, t_wait1 = 0;
+		if (surya_fb_mode >= 2) {
+			/* Wait for the scan to pass the top of a frame, then copy behind it
+			 * (surya_panel_line, bsd/dev/sweet_touch.c). At most 20 ms. */
+			uint64_t until = mach_absolute_time() + fVsyncPeriod + fVsyncPeriod / 4;
+			t_wait0 = mach_absolute_time();
+			int line = surya_panel_line();
+			line_wait = line;
+			if (line >= 0) {
+				/* first let a scan that is near the top move on, then catch the next top */
+				while (line < 200 && mach_absolute_time() < until) {
+					IODelay(200);
+					line = surya_panel_line();
+				}
+				while (line >= 200 && mach_absolute_time() < until) {
+					IODelay(100);
+					line = surya_panel_line();
+				}
+			}
+			line_start = line;
+			t_wait1 = mach_absolute_time();
+			/* 23.10 diagnostics: seams stayed (top and middle). Once: how LINE_COUNT
+			 * sweeps over 40 ms; then the first 30 copies and one in 300: the line
+			 * at the swap, after the wait, after the copy, and the times. */
+			static unsigned diag_count;
+			if (diag_count == 0) {
+				char buf[200];
+				int n = 0;
+				for (unsigned i = 0; i < 40; i++) {
+					n += snprintf(buf + n, sizeof(buf) - (size_t)n, " %d", surya_panel_line());
+					if (n > 170) {
+						IOLog("SWEET FB: line sweep (1 ms):%s\n", buf);
+						n = 0;
+					}
+					IODelay(1000);
+				}
+				IOLog("SWEET FB: line sweep (1 ms):%s\n", buf);
+			}
+			diag_count++;
+		}
+		if (fWorker) {
+			IOLockLock(fLock);
+			fWorkPending = true;
+			fWorkDone = false;
+			IOLockWakeup(fLock, &fWorkPending, false);
+			IOLockUnlock(fLock);
+			present(fCopyRec, 0, 2);
+			IOLockLock(fLock);
+			while (!fWorkDone) {
+				(void)IOLockSleep(fLock, &fWorkDone, THREAD_UNINT);
+			}
+			IOLockUnlock(fLock);
+		} else {
+			present(fCopyRec);
+		}
+		if (surya_fb_mode >= 2) {
+			static unsigned diag_n;
+			diag_n++;
+			if (diag_n <= 30 || diag_n % 300 == 0) {
+				uint64_t wait_ns = 0, copy_ns = 0, now = mach_absolute_time();
+				absolutetime_to_nanoseconds(t_wait1 - t_wait0, &wait_ns);
+				absolutetime_to_nanoseconds(now - t_wait1, &copy_ns);
+				IOLog("SWEET FB: copy %u: line at swap %d, after wait %d (%llu us), after copy %d (%llu us)\n",
+				    diag_n, line_wait, line_start, (unsigned long long)(wait_ns / 1000ULL),
+				    surya_panel_line(), (unsigned long long)(copy_ns / 1000ULL));
+			}
+		}
+		IOLockLock(fLock);
+		IOLockWakeup(fLock, &fDirty, false); /* SwapWait: the frame is on the panel */
+		IOLockUnlock(fLock);
+	}
+}
+
+static void
+surya_fb_copy_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	((AppleCLCD *)arg)->copyLoop();
+}
+
+void
+AppleCLCD::workerLoop(void)
+{
+	for (;;) {
+		IOLockLock(fLock);
+		while (!fWorkPending) {
+			(void)IOLockSleep(fLock, &fWorkPending, THREAD_UNINT);
+		}
+		fWorkPending = false;
+		IOLockUnlock(fLock);
+		present(fCopyRec, 1, 2);
+		IOLockLock(fLock);
+		fWorkDone = true;
+		IOLockWakeup(fLock, &fWorkDone, false);
+		IOLockUnlock(fLock);
+	}
+}
+
+static void
+surya_fb_worker_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	((AppleCLCD *)arg)->workerLoop();
+}
+
+/* surya mode SwapWait: until the pending frame has been copied, at most 50 ms. */
+void
+AppleCLCD::swapWait(void)
+{
+	uint64_t deadline = mach_absolute_time() + 3 * fVsyncPeriod;
+	IOLockLock(fLock);
+	if (surya_fb_mode == 3) {
+		/* suryafb=3 (23.10): the copy started at the swap (as 2), but CoreAnimation
+		 * gets one swap per vsync tick: with 2 it re-rendered unchanged frames
+		 * at full speed (xr5: 64 swaps a second, 95 %% identical) and the user
+		 * saw less smoothness than with the slow single-threaded copy. */
+		uint64_t count = fVsyncCount;
+		while (fVsyncCount == count && !fPowerOff && mach_absolute_time() < deadline) {
+			(void)IOLockSleepDeadline(fLock, &fVsyncCount, deadline, THREAD_UNINT);
+		}
+		IOLockUnlock(fLock);
+		return;
+	}
+	while (fDirty && !fPowerOff && mach_absolute_time() < deadline) {
+		(void)IOLockSleepDeadline(fLock, &fDirty, deadline, THREAD_UNINT);
+	}
+	IOLockUnlock(fLock);
 }
 
