+/* surya mode: copies the latest frame whenever the vsync timer asks. */
+void
+AppleCLCD::copyLoop(void)
+{
+	bool cache_reset = !surya_fb_2x;
+	for (;;) {
+		if (!cache_reset) {
+			int err = surya_fb2x_reset_cache();
+			if (err != EAGAIN) {
+				cache_reset = true;
+				IOLog("SWEET FB: @2x: MobileGestalt cache truncated (err %d)\n", err);
+			}
+		}
+		IOLockLock(fLock);
+		while (!fCopyWanted) {
+			(void)IOLockSleep(fLock, &fCopyWanted, THREAD_UNINT);
+		}
+		fCopyWanted = false;
+		memcpy(fCopyRec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		IOLockUnlock(fLock);
+		int line_start = -1, line_wait = -1;
+		uint64_t t_wait0 = 0, t_wait1 = 0;
+		uint32_t back = 0;
+		if (surya_fb_mode == 4) {
+			/* The buffer about to be written must be off the panel: the last
+			 * flip (to the other one) has to be latched first. */
+			uint64_t until = mach_absolute_time() + 2 * fVsyncPeriod;
+			if (surya_mdss_flip_pending()) {
+				sweet_fb_stat_flip_late++;
+				while (surya_mdss_flip_pending() && mach_absolute_time() < until) {
+					IODelay(100);
+				}
+			}
+			back = fFront ^ 1;
+			fDst = fBufPixels[back];
+		}
+		if (surya_fb_mode == 2 || surya_fb_mode == 3) {
+			/* Wait for the scan to pass the top of a frame, then copy behind it
+			 * (surya_panel_line, bsd/dev/sweet_touch.c). At most 20 ms. */
+			uint64_t until = mach_absolute_time() + fVsyncPeriod + fVsyncPeriod / 4;
+			t_wait0 = mach_absolute_time();
+			int line = surya_panel_line();
+			line_wait = line;
+			if (line >= 0) {
+				/* 23.10 (shim-xr9 diagnostics): LINE_COUNT runs 0..~4860 a frame, two
+				 * counts per panel row. A copy started at the top overtook the scan a
+				 * few rows down (a seam at the top) and the second thread's rows were
+				 * caught in the middle. Start while the scan is in the bottom part
+				 * (counts 3900..4600, rows ~1950..2300): it wraps to row 0 after
+				 * ~2.5 ms, by when the copy, twice as fast as the scan, is ~700 rows
+				 * in; the two never meet if the copy takes under ~15 ms. */
+				while ((line < 3900 || line >= 4600) && mach_absolute_time() < until) {
+					IODelay(100);
+					line = surya_panel_line();
+				}
+			}
