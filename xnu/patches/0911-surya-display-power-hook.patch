+
+void
+AppleCLCD::workerLoop(void)
+{
+	for (;;) {
+		IOLockLock(fLock);
+		while (!fWorkPending) {
+			(void)IOLockSleep(fLock, &fWorkPending, THREAD_UNINT);
+		}
+		fWorkPending = false;
+		IOLockUnlock(fLock);
+		present(fCopyRec, 1, 2);
+		IOLockLock(fLock);
+		fWorkDone = true;
+		IOLockWakeup(fLock, &fWorkDone, false);
+		IOLockUnlock(fLock);
+	}
+}
+
+static void
+surya_fb_worker_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	((AppleCLCD *)arg)->workerLoop();
+}
