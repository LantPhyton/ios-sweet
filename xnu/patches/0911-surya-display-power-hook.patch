+		 * gets one swap per vsync tick: with 2 it re-rendered unchanged frames
+		 * at full speed (xr5: 64 swaps a second, 95 %% identical) and the user
+		 * saw less smoothness than with the slow single-threaded copy. */
+		uint64_t count = fVsyncCount;
+		while (fVsyncCount == count && !fPowerOff && mach_absolute_time() < deadline) {
+			(void)IOLockSleepDeadline(fLock, &fVsyncCount, deadline, THREAD_UNINT);
+		}
