+static void
+surya_pin(vm_offset_t tile, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(tile, off);
+	if (out) {
+		touch_wr(tile, TOUCH_GPIO_IO(pin),
+		    (touch_rd(tile, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(tile, off, cfg);
+}
+
+/* The GCC vote register is shared by the touch (SE0) and vibrator (SE1) threads. */
+static IOLock *surya_gcc_lock;
+
+/* One wrapper-0 SE clock: vote, XO on its RCG, every branch running. */
+static bool
+surya_qup_clocks(vm_offset_t gcc, uint32_t vote, uint32_t rcg, uint32_t se_branch,
+    const char *who)
+{
+	if (surya_gcc_lock) {
+		IOLockLock(surya_gcc_lock);
+	}
+	touch_wr(gcc, TOUCH_GCC_VOTE, touch_rd(gcc, TOUCH_GCC_VOTE) | vote);
+	if (surya_gcc_lock) {
+		IOLockUnlock(surya_gcc_lock);
+	}
+	uint32_t dfs = touch_rd(gcc, rcg + 0x14u);
+	uint32_t cfg = touch_rd(gcc, rcg + 4u);
+	printf("SURYA %s: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    who, touch_rd(gcc, TOUCH_GCC_VOTE), touch_rd(gcc, rcg), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = touch_rd(gcc, rcg + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SURYA %s: DFS level0=%#x is not XO/1; need clock integration\n", who, cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(gcc, rcg + 4u, cfg);
+		touch_wr(gcc, rcg, touch_rd(gcc, rcg) | 1u);
+		if (!touch_wait_clear(gcc, rcg, 1u)) {
+			printf("SURYA %s: RCG update timeout\n", who);
+			return false;
+		}
+	}
+	/* gcc-sdmmagpie.c halt registers: m_ahb, s_ahb, core, core_2x, the SE. */
+	const uint32_t branches[] = {0x17004, 0x17008, 0x1700c, 0x17014, se_branch};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(gcc, branches[i], 1u << 31)) {
+			printf("SURYA %s: GCC branch %#x halted (%#x)\n", who, branches[i],
+			    touch_rd(gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+surya_clocks(void)
+{
+	return surya_qup_clocks(st.gcc, SURYA_VOTE_MASK, SURYA_RCG, 0x17030, "TOUCH");
+}
+
+static bool
+surya_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("SURYA TOUCH: se0 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx);
+	/* Protocol 1 = SPI (qcom-geni-se.h); SE firmware comes from qupfw. */
+	if (((fw >> 8) & 0xffu) != 1u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SURYA TOUCH: need SPI firmware on SE0 and 32-bit FIFOs; stopping\n");
+		return false;
+	}
+	sy.depth = (tx >> 16) & 0x3fu;
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SURYA TOUCH: SE0 already busy; stopping\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	/* spi-geni-qcom.c setup_fifo_params: CS0, mode 0, no loopback, no delays. */
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (4u << 4) | 1u); /* 19.2 MHz / 4 = 4.8 MHz */
+	touch_wr(st.se, SPI_LOOPBACK_REG, 0);
+	touch_wr(st.se, SPI_DEMUX_SEL, 0);
+	touch_wr(st.se, SPI_CPHA_REG, 0);
+	touch_wr(st.se, SPI_CPOL_REG, 0);
+	touch_wr(st.se, SPI_DEMUX_INV, 0);
+	touch_wr(st.se, SPI_DELAYS, 0);
+	touch_wr(st.se, SPI_WORD_LEN, (touch_rd(st.se, SPI_WORD_LEN) & ~0x3ffu) | (8u - 4u));
+	touch_wr(st.se, SPI_TRANS_CFG, touch_rd(st.se, SPI_TRANS_CFG) & ~1u); /* no CS toggle */
+	/* 8-bit words, four per FIFO word, MSB first: the packing sweet verified. */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    (touch_rd(st.se, SPI_WORD_LEN) & 0x3ffu) != 4u) {
+		printf("SURYA TOUCH: SPI config readback mismatch; stopping\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SURYA TOUCH: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+surya_drain(uint8_t *rx, unsigned len, unsigned *got)
+{
+	uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+	for (unsigned i = 0; i < count && i < 64; ++i) {
+		uint32_t word = touch_rd(st.se, SE_RX);
+		for (unsigned j = 0; j < 4 && rx && *got < len; ++j) {
+			rx[(*got)++] = (uint8_t)(word >> (8u * j));
+		}
+	}
+}
+
+/* One FIFO-mode SPI transfer: TX only, or full duplex of len bytes. */
+static int
+surya_spi(unsigned op, const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	unsigned sent = 0, got = 0;
+	if (st.dead || !len || len > sizeof(sy.big) || (op == SPI_OP_FULL && (!rx || len > SURYA_SPI_MAX))) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE0 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SPI_TX_LEN, len);
+	touch_wr(st.se, SPI_RX_LEN, op == SPI_OP_FULL ? len : 0u);
+	touch_wr(st.se, SE_CMD, op << 27); /* no FRAGMENTATION: CS drops at the end */
+	for (unsigned i = 0; i < 20000u + 8u * len; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SE_ERRORS) {
+			printf("SURYA TOUCH: spi op=%u len=%u error irq=%#x\n", op, len, irq);
+			break;
+		}
+		while (sent < len && (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) < sy.depth) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && sent < len; ++j, ++sent) {
+				word |= (uint32_t)(tx ? tx[sent] : 0u) << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+		}
+		surya_drain(rx, op == SPI_OP_FULL ? len : 0u, &got);
+		if (irq & SE_DONE) {
+			surya_drain(rx, op == SPI_OP_FULL ? len : 0u, &got);
+			touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+			if (sent == len && (op != SPI_OP_FULL || got == len)) {
+				return 0;
+			}
+			printf("SURYA TOUCH: spi op=%u len=%u short sent=%u got=%u\n", op, len, sent, got);
+			return EIO;
+		}
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return ETIMEDOUT;
+}
+
+/* nt36xxx.c CTP_SPI_WRITE: first byte | 0x80, TX only. */
+static int
+surya_nvt_write(const uint8_t *buf, unsigned len)
+{
+	if (len > SURYA_SPI_MAX) {
+		return EIO;
+	}
+	memcpy(sy.tx, buf, len);
+	sy.tx[0] |= 0x80u;
+	return surya_spi(SPI_OP_TX, sy.tx, NULL, len);
+}
+
+/* nt36xxx.c CTP_SPI_READ: first byte & 0x7f, len + 1 bytes full duplex,
+ * data from the third received byte on goes to buf[1..len-1]. */
+static int
+surya_nvt_read(uint8_t *buf, unsigned len)
+{
+	if (len < 2 || len + 1u > SURYA_SPI_MAX) {
+		return EIO;
+	}
+	memset(sy.tx, 0, len + 1u);
+	memcpy(sy.tx, buf, len);
+	sy.tx[0] &= 0x7fu;
+	int err = surya_spi(SPI_OP_FULL, sy.tx, sy.rx, len + 1u);
+	if (!err) {
+		memcpy(buf + 1, sy.rx + 2, len - 1u);
+	}
+	return err;
+}
+
+static int
+surya_nvt_page(uint32_t addr)
+{
+	const uint8_t buf[3] = {0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7)};
+	return surya_nvt_write(buf, sizeof(buf));
+}
+
+static int
+surya_nvt_write_addr(uint32_t addr, uint8_t data)
+{
+	int err = surya_nvt_page(addr);
+	if (err) {
+		return err;
+	}
+	const uint8_t buf[2] = {(uint8_t)(addr & 0x7fu), data};
+	return surya_nvt_write(buf, sizeof(buf));
+}
+
+/* nt36xxx.c nvt_bootloader_reset + nvt_ts_check_chip_ver_trim. */
+static int
+surya_nvt_chip_id(uint8_t id[6])
+{
+	int err = surya_nvt_write_addr(NVT_SWRST_N8, 0x69);
+	if (err) {
+		return err;
+	}
+	touch_wait(5); /* tBRST2FR after bootloader reset */
+	err = surya_nvt_write_addr(NVT_RD_FAST, 0x00);
+	if (err) {
+		return err;
+	}
+	err = surya_nvt_page(NVT_CHIP_ID);
+	if (err) {
+		return err;
+	}
+	uint8_t buf[8] = {(uint8_t)(NVT_CHIP_ID & 0x7fu)};
+	err = surya_nvt_read(buf, 7);
+	if (!err) {
+		memcpy(id, buf + 1, 6);
+	}
+	return err;
+}
+
+static const char *
+surya_chip_name(const uint8_t id[6])
+{
+	for (unsigned k = 0; k < sizeof(surya_ids) / sizeof(surya_ids[0]); ++k) {
+		unsigned i;
+		for (i = 0; i < 6; ++i) {
+			if (surya_ids[k].mask[i] && id[i] != surya_ids[k].id[i]) {
+				break;
+			}
+		}
+		if (i == 6) {
+			return surya_ids[k].name;
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+nvt_le32(const uint8_t *p)
+{
+	return p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Read len-1 data bytes at addr into buf[1..] (page set first). */
+static int
+surya_nvt_read_at(uint32_t addr, uint8_t *buf, unsigned len)
+{
+	int err = surya_nvt_page(addr);
+	if (err) {
+		return err;
+	}
+	memset(buf, 0, len);
+	buf[0] = (uint8_t)(addr & 0x7fu);
+	return surya_nvt_read(buf, len);
+}
+
+/*
+ * update_firmware_request + nvt_bin_header_parser (hw_crc != 0: the CRCs come
+ * from the header). Checks every range against the file before any SPI write.
+ */
+static bool
+surya_fw_parse(const uint8_t *fw, unsigned size)
+{
+	unsigned need = 0;
+	for (unsigned i = size / 4096u; i > 0; --i) {
+		const uint8_t *flag = fw + i * 4096u - 3u;
+		if (!memcmp(flag, "NVT", 3) || !memcmp(flag, "MOD", 3)) {
+			need = i * 4096u;
+			break;
+		}
+	}
+	if (!need) {
+		printf("SURYA TOUCH: firmware has no NVT/MOD end flag\n");
+		return false;
+	}
+	nvt_fw_ver = fw[need - 4096u];
+	if (fw[need - 4096u] + fw[need - 4096u + 1u] != 0xff) {
+		printf("SURYA TOUCH: firmware version %#x + bar %#x != 0xff\n",
+		    fw[need - 4096u], fw[need - 4096u + 1u]);
+		return false;
+	}
+	uint32_t end = nvt_le32(fw);
+	unsigned info = 0;
+	for (uint32_t pos = 0x30u; pos < end; pos += 0x10u) {
+		++info;
+	}
+	unsigned ovly = (fw[0x28] & 0x10u) ? (fw[0x28] & 0x0fu) : 0u;
+	nvt_nparts = 2u + info + ovly;
+	if (nvt_nparts > NVT_FW_PARTS || 0x30u + 0x10u * info > size) {
+		printf("SURYA TOUCH: firmware header end=%#x info=%u ovly=%u is too large\n", end, info, ovly);
+		return false;
+	}
+	for (unsigned k = 0; k < nvt_nparts; ++k) {
+		const uint8_t *p;
+		if (k < 2u) {
+			p = fw + 12u * k;
+			nvt_parts[k].bin = nvt_le32(p);
+			nvt_parts[k].sram = nvt_le32(p + 4);
+			nvt_parts[k].size = nvt_le32(p + 8);
+			nvt_parts[k].crc = nvt_le32(fw + 0x18u + 4u * k);
+		} else {
+			uint32_t pos = k < 2u + info ? 0x30u + 0x10u * (k - 2u)
+			    : nvt_parts[1].bin + 0x10u * (k - 2u - info);
+			if (pos + 16u > size) {
+				printf("SURYA TOUCH: firmware header entry %u at %#x outside file\n", k, pos);
+				return false;
+			}
+			p = fw + pos;
+			nvt_parts[k].sram = nvt_le32(p);
+			nvt_parts[k].size = nvt_le32(p + 4);
+			nvt_parts[k].bin = nvt_le32(p + 8);
+			nvt_parts[k].crc = nvt_le32(p + 12);
+		}
+		/* nvt_write_firmware sends size + 1 bytes of a non-empty piece. */
+		if (nvt_parts[k].size &&
+		    ((uint64_t)nvt_parts[k].bin + nvt_parts[k].size + 1u > size)) {
+			printf("SURYA TOUCH: firmware piece %u bin=%#x size=%#x outside file\n",
+			    k, nvt_parts[k].bin, nvt_parts[k].size);
+			return false;
+		}
+	}
+	printf("SURYA TOUCH: firmware %u bytes, write size %#x, version %#x, %u pieces\n",
+	    size, need, fw[need - 4096u], nvt_nparts);
+	for (unsigned k = 0; k < nvt_nparts; ++k) {
+		if (nvt_parts[k].size) {
+			printf("SURYA TOUCH:   piece %u bin=%#x sram=%#x size=%#x crc=%#x\n", k,
+			    nvt_parts[k].bin, nvt_parts[k].sram, nvt_parts[k].size, nvt_parts[k].crc);
+		}
+	}
+	return true;
+}
+
+/* nvt_write_sram, in NVT_FW_CHUNK pieces: set page, then offset | 0x80 + data. */
+static int
+surya_nvt_sram(const uint8_t *data, uint32_t sram, uint32_t size)
+{
+	while (size) {
+		unsigned len = size < NVT_FW_CHUNK ? size : NVT_FW_CHUNK;
+		int err = surya_nvt_page(sram);
+		if (err) {
+			return err;
+		}
+		sy.big[0] = (uint8_t)((sram & 0x7fu) | 0x80u);
+		memcpy(sy.big + 1, data, len);
+		err = surya_spi(SPI_OP_TX, sy.big, NULL, len + 1u);
+		if (err) {
+			printf("SURYA TOUCH: sram write at %#x len %u failed %d\n", sram, len, err);
+			return err;
+		}
+		data += len;
+		sram += len;
+		size -= len;
+	}
+	return 0;
+}
+
+/* nvt_set_bld_crc_bank, hw_crc > 1: all three registers share one page. */
+static int
+surya_nvt_crc_bank(uint32_t des, uint32_t sram, uint32_t len_addr, uint32_t size,
+    uint32_t golden, uint32_t crc)
+{
+	int err = surya_nvt_page(des);
+	const uint8_t d[4] = {(uint8_t)(des & 0x7fu), (uint8_t)sram, (uint8_t)(sram >> 8), (uint8_t)(sram >> 16)};
+	const uint8_t l[4] = {(uint8_t)(len_addr & 0x7fu), (uint8_t)size, (uint8_t)(size >> 8),
+		                  (uint8_t)((size >> 16) & 1u)};
+	const uint8_t g[5] = {(uint8_t)(golden & 0x7fu), (uint8_t)crc, (uint8_t)(crc >> 8),
+		                  (uint8_t)(crc >> 16), (uint8_t)(crc >> 24)};
+	if (!err) {
+		err = surya_nvt_write(d, sizeof(d));
+	}
+	if (!err) {
+		err = surya_nvt_write(l, sizeof(l));
+	}
+	if (!err) {
+		err = surya_nvt_write(g, sizeof(g));
+	}
+	return err;
+}
+
+/* nvt_read_bld_hw_crc: CRC flags and golden/result sums after a failure. */
+static void
+surya_nvt_crc_dump(void)
+{
+	uint8_t b[8];
+	uint32_t gi = 0, ri = 0, gd = 0, rd = 0;
+	if (!surya_nvt_read_at(NVT_BLD_CRC_FLAG, b, 2)) {
+		printf("SURYA TOUCH: crc flag %#x (done=%u ilm_err=%u dlm_err=%u)\n",
+		    b[1], (b[1] >> 2) & 1u, b[1] & 1u, (b[1] >> 1) & 1u);
+	}
+	if (!surya_nvt_read_at(NVT_G_ILM_CHK, b, 5)) {
+		gi = nvt_le32(b + 1);
+	}
+	if (!surya_nvt_read_at(NVT_R_ILM_CHK, b, 5)) {
+		ri = nvt_le32(b + 1);
+	}
+	if (!surya_nvt_read_at(NVT_G_DLM_CHK, b, 5)) {
+		gd = nvt_le32(b + 1);
+	}
+	if (!surya_nvt_read_at(NVT_R_DLM_CHK, b, 5)) {
+		rd = nvt_le32(b + 1);
+	}
+	printf("SURYA TOUCH: ilm bin=%#x golden=%#x result=%#x; dlm bin=%#x golden=%#x result=%#x\n",
+	    nvt_parts[0].crc, gi, ri, nvt_parts[1].crc, gd, rd);
+}
+
+/* One pass of nvt_download_firmware_hw_crc; returns the reset state read last. */
+static int
+surya_nvt_download(const uint8_t *fw, uint8_t *state)
+{
+	uint8_t b[8];
+	*state = 0;
+	/* nvt_bootloader_reset */
+	int err = surya_nvt_write_addr(NVT_SWRST_N8, 0x69);
+	if (err) {
+		return err;
+	}
+	touch_wait(5);
+	if ((err = surya_nvt_write_addr(NVT_RD_FAST, 0x00))) {
+		return err;
+	}
+	/* nvt_write_firmware: every non-empty piece, size + 1 bytes. */
+	for (unsigned k = 0; k < nvt_nparts; ++k) {
+		if (nvt_parts[k].size &&
+		    (err = surya_nvt_sram(fw + nvt_parts[k].bin, nvt_parts[k].sram, nvt_parts[k].size + 1u))) {
+			return err;
+		}
+	}
+	/* nvt_set_bld_hw_crc: ILM and DLM destination, length, golden CRC. */
+	if ((err = surya_nvt_crc_bank(NVT_ILM_DES, nvt_parts[0].sram, NVT_ILM_LENGTH,
+	    nvt_parts[0].size, NVT_G_ILM_CHK, nvt_parts[0].crc)) ||
+	    (err = surya_nvt_crc_bank(NVT_DLM_DES, nvt_parts[1].sram, NVT_DLM_LENGTH,
+	    nvt_parts[1].size, NVT_G_DLM_CHK, nvt_parts[1].crc))) {
+		return err;
+	}
+	/* nvt_bld_crc_enable: set bit 7 of BLD_CRC_EN. */
+	if ((err = surya_nvt_read_at(NVT_BLD_CRC_EN, b, 2))) {
+		return err;
+	}
+	const uint8_t en[2] = {(uint8_t)(NVT_BLD_CRC_EN & 0x7fu), (uint8_t)(b[1] | 0x80u)};
+	if ((err = surya_nvt_write(en, sizeof(en)))) {
+		return err;
+	}
+	/* nvt_fw_crc_enable: clear reset status, host command 0xAE. */
+	const uint8_t clr[2] = {NVT_EV_RESET, 0x00};
+	const uint8_t cmd[2] = {NVT_EV_HOST_CMD, 0xae};
+	if ((err = surya_nvt_page(NVT_EVENT_BUF)) || (err = surya_nvt_write(clr, sizeof(clr))) ||
+	    (err = surya_nvt_write(cmd, sizeof(cmd)))) {
+		return err;
+	}
+	/* nvt_boot_ready */
+	if ((err = surya_nvt_write_addr(NVT_BOOT_RDY, 1))) {
+		return err;
+	}
+	touch_wait(5);
+	/* nvt_check_fw_reset_state(RESET_STATE_INIT): 0xA0..0xAF within ~100 ms. */
+	for (unsigned retry = 0; retry <= 10; ++retry) {
+		if ((err = surya_nvt_read_at(NVT_EVENT_BUF | NVT_EV_RESET, b, 6))) {
+			return err;
+		}
+		*state = b[1];
+		if (b[1] >= 0xa0u && b[1] <= 0xafu) {
+			return 0;
+		}
+		touch_wait(10);
+	}
+	return ETIMEDOUT;
+}
+
+/* Milestone 2: load, check, download; then nvt_get_fw_info + nvt_read_pid. */
+static bool
+surya_fw_load(void)
+{
+	DTEntry node;
+	const uint8_t *fw = NULL;
+	unsigned size = 0;
+	if (SecureDTLookupEntry(NULL, "/surya-touch", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "firmware", (void const **)&fw, &size) != kSuccess ||
+	    size < 4096u) {
+		printf("SURYA TOUCH: no /surya-touch firmware in the device tree\n");
+		return false;
+	}
+	if (!surya_fw_parse(fw, size)) {
+		return false;
+	}
+	int err = EIO;
+	uint8_t state = 0;
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	for (unsigned attempt = 0; attempt < 3 && !st.dead; ++attempt) {
+		err = surya_nvt_download(fw, &state);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		printf("SURYA TOUCH: download attempt %u err=%d reset state=%#x after %llu ms\n",
+		    attempt, err, state, ns / 1000000ull);
+		if (!err) {
+			break;
+		}
+	}
+	if (err) {
+		if (!st.dead) {
+			surya_nvt_crc_dump();
+		}
+		return false;
+	}
+	uint8_t b[20];
+	if (surya_nvt_read_at(NVT_EVENT_BUF | NVT_EV_FWINFO, b, 17)) {
+		return false;
+	}
+	unsigned ver = b[1], bar = b[2], x = b[3], y = b[4];
+	unsigned w = ((unsigned)b[5] << 8) | b[6], h = ((unsigned)b[7] << 8) | b[8];
+	printf("SURYA TOUCH: fw info ver=%#x ~ver=%#x grid=%ux%u max=%ux%u buttons=%u type=%#x\n",
+	    ver, bar, x, y, w, h, b[11], b[14]);
+	if (ver + bar == 0xffu && w && h) {
+		nvt_max_x = w;
+		nvt_max_y = h;
+	}
+	unsigned pid = 0;
+	if (!surya_nvt_read_at(NVT_EVENT_BUF | NVT_EV_PID, b, 3)) {
+		pid = ((unsigned)b[2] << 8) | b[1];
+		printf("SURYA TOUCH: pid=%04x\n", pid);
+	}
+	/*
+	 * Milestone 2 check: the running firmware is the file's, and its grid is
+	 * the one surya's DT gives for this PID (novatek-mp-criteria-5936: 18x36,
+	 * -5938: 16x36).
+	 */
+	unsigned want_x = pid == 0x5936u ? 18u : pid == 0x5938u ? 16u : 0u;
+	return ver + bar == 0xffu && ver == nvt_fw_ver && x == want_x && y == 36u;
+}
+
+/* Milestone 3 state: fingers down after the last frame, as in nvt_ts_work_func. */
+static struct {
+	uint32_t down;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	unsigned wdt, quiet, edges, reads, errors;
+} sf;
+
+static void
+surya_touch_release_all(void)
+{
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		if (sf.down & (1u << i)) {
+			printf("SURYA TOUCH: finger %u up x=%d y=%d\n", i + 1u, sf.x[i], sf.y[i]);
+		}
+	}
+	sf.down = 0;
+	touch_report(0, st.x, st.y);
+}
+
+static void surya_tap_track(uint32_t now, const int *x, const int *y);
+
+/* One event-buffer read: nvt_ts_work_func parsing; logs instead of input reports. */
+static void
+surya_touch_frame(void)
+{
+	uint8_t b[NVT_POINT_LEN + 1u];
+	int err = surya_nvt_read_at(NVT_EVENT_BUF, b, sizeof(b));
+	++sf.reads;
+	if (err) {
+		if ((sf.errors++ % 100u) == 0) {
+			printf("SURYA TOUCH: event read err=%d\n", err);
+		}
+		if (sf.errors == 10) {
+			surya_touch_release_all();
+		}
+		return;
+	}
+	sf.errors = 0;
+	/* nvt_wdt_fw_recovery: firmware reset leaves 0xFD/0xFE in bytes 1..6. */
+	bool wdt = true;
+	for (unsigned i = 1; i < 7; ++i) {
+		if (b[i] != 0xfdu && b[i] != 0xfeu) {
+			wdt = false;
+		}
+	}
+	if (wdt) {
+		if (++sf.wdt > 10u) {
+			printf("SURYA TOUCH: firmware watchdog pattern %02x; reloading firmware\n", b[1]);
+			sf.wdt = 0;
+			surya_touch_release_all();
+			printf("SURYA TOUCH: reload %s\n", surya_fw_load() ? "ok" : "FAILED");
+		}
+		return;
+	}
+	sf.wdt = 0;
+	uint32_t now = 0;
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0}, w[TOUCH_MAX] = {0};
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = b + 1u + 6u * i;
+		unsigned id = p[0] >> 3, state = p[0] & 7u;
+		/* 1: finger enters, 2: finger moves; other ids are gesture/palm packets. */
+		if (!id || id > TOUCH_MAX || (state != 1u && state != 2u)) {
+			continue;
+		}
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] >> 4u);
+		unsigned py = ((unsigned)p[2] << 4) | (p[3] & 0x0fu);
+		if (px > nvt_max_x || py > nvt_max_y) {
+			continue;
+		}
+		now |= 1u << (id - 1u);
+		x[id - 1u] = (int)px;
+		y[id - 1u] = (int)py;
+		w[id - 1u] = p[4] ? p[4] : 1;
+	}
+	bool moved = false;
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		uint32_t bit = 1u << i;
+		if ((now & bit) && !(sf.down & bit)) {
+			printf("SURYA TOUCH: finger %u down x=%d y=%d w=%d\n", i + 1u, x[i], y[i], w[i]);
+		} else if (!(now & bit) && (sf.down & bit)) {
+			printf("SURYA TOUCH: finger %u up x=%d y=%d\n", i + 1u, sf.x[i], sf.y[i]);
+		} else if ((now & bit) && (x[i] != sf.x[i] || y[i] != sf.y[i])) {
+			moved = true;
+		}
+		if (now & bit) {
+			sf.x[i] = x[i];
+			sf.y[i] = y[i];
+		}
+	}
+	/* Moves: at most one line per ~100 ms, all fingers down. */
+	if (moved && ++sf.quiet >= 10u) {
+		sf.quiet = 0;
+		for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+			if (now & (1u << i)) {
+				printf("SURYA TOUCH: finger %u move x=%d y=%d w=%d\n", i + 1u, x[i], y[i], w[i]);
+			}
+		}
+	}
+	sf.down = now;
+	surya_tap_track(now, x, y);
+	/* Milestone 4: same panel pixels as the sweet ICs, same path into SweetHID. */
+	touch_report(now, x, y);
+}
+
+/*
+ * Poll every 10 ms like the sweet driver, but read on fresh frames: TLMM
+ * latches gpio9's rising edge (RAW_STATUS_EN, DETECT=1, POLARITY=1) with
+ * INTR_ENABLE left 0, so no CPU interrupt is raised. Fallback reads every
+ * 100 ms, and every tick while a finger is down.
+ */
+static void
+surya_touch_loop(void)
+{
+	surya_pin(st.gpio, SURYA_IRQ_GPIO, 0, 0, 0, false, false); /* input, no pull */
+	uint32_t ic = touch_rd(st.gpio, TLMM_INTR_CFG(SURYA_IRQ_GPIO));
+	touch_wr(st.gpio, TLMM_INTR_CFG(SURYA_IRQ_GPIO),
+	    (ic & ~0x1fu) | (1u << 4) | (1u << 2) | (1u << 1));
+	touch_wr(st.gpio, TLMM_INTR_STATUS(SURYA_IRQ_GPIO), 0);
+	printf("SURYA TOUCH: milestones 3-4 polling, intr_cfg %#x -> %#x\n",
+	    ic, touch_rd(st.gpio, TLMM_INTR_CFG(SURYA_IRQ_GPIO)));
+	unsigned ticks = 0;
+	while (!st.dead) {
+		bool edge = touch_rd(st.gpio, TLMM_INTR_STATUS(SURYA_IRQ_GPIO)) & 1u;
+		if (edge) {
+			touch_wr(st.gpio, TLMM_INTR_STATUS(SURYA_IRQ_GPIO), 0);
+			++sf.edges;
+		}
+		if (edge || sf.down || (ticks % 10u) == 0) {
+			surya_touch_frame();
+		}
+		if (++ticks % 3000u == 0) {
+			printf("SURYA TOUCH: stats edges=%u reads=%u\n", sf.edges, sf.reads);
+		}
+		touch_wait(10);
+	}
+	printf("SURYA TOUCH: SE0 dead; touch loop stopped\n");
+	surya_touch_release_all();
+}
+
+static void
+surya_touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SURYA TOUCH: Novatek SPI milestones 1-4 (chip id, firmware, points, HID) in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("SURYA TOUCH: mapping GCC/TLMM/SE0\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	sy.west = ml_io_map(SURYA_WEST_PA, 0x35000);
+	st.se = ml_io_map(SURYA_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !sy.west || !st.se) {
+		printf("SURYA TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SURYA TOUCH: before: spi cfg %#x %#x %#x %#x rst cfg=%#x io=%#x irq cfg=%#x io=%#x\n",
+	    touch_rd(sy.west, TOUCH_GPIO_CFG(49)), touch_rd(sy.west, TOUCH_GPIO_CFG(50)),
+	    touch_rd(sy.west, TOUCH_GPIO_CFG(51)), touch_rd(sy.west, TOUCH_GPIO_CFG(52)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(SURYA_RST_GPIO)), touch_rd(st.gpio, TOUCH_GPIO_IO(SURYA_RST_GPIO)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(SURYA_IRQ_GPIO)), touch_rd(st.gpio, TOUCH_GPIO_IO(SURYA_IRQ_GPIO)));
+	if (!surya_clocks() || !surya_se_init()) {
+		goto out;
+	}
+	for (unsigned pin = 49; pin <= 52; ++pin) {
+		surya_pin(sy.west, pin, 2, 0, 2, false, false); /* qup00, no pull, 6 mA */
+	}
+	/* Linux probe: reset requested low, then high, 10 ms after power-on reset. */
+	surya_pin(st.gpio, SURYA_RST_GPIO, 0, 0, 0, true, false);
+	touch_wait(5);
+	surya_pin(st.gpio, SURYA_RST_GPIO, 0, 0, 0, true, true);
+	touch_wait(20);
+	uint8_t id[6] = {0};
+	int err = EIO;
+	for (unsigned retry = 0; retry < 5 && !st.dead; ++retry) {
+		err = surya_nvt_chip_id(id);
+		printf("SURYA TOUCH: chip id try %u err=%d id=%02x %02x %02x %02x %02x %02x irq=%#x\n",
+		    retry, err, id[0], id[1], id[2], id[3], id[4], id[5], st.irq_status);
+		if (!err && surya_chip_name(id)) {
+			break;
+		}
+		touch_wait(10);
+	}
+	const char *name = err ? NULL : surya_chip_name(id);
+	printf("SURYA TOUCH: milestone 1 %s: %s\n", name ? "PASSED" : "FAILED",
+	    name ? name : "no Novatek id");
+	/* Only the 0c xx xx 72 66 03 chip uses the NT36675 map hard-coded above. */
+	if (!name || id[0] != 0x0cu || id[3] != 0x72u || id[4] != 0x66u || id[5] != 0x03u) {
+		goto out;
+	}
+	if (!surya_fw_load()) {
+		printf("SURYA TOUCH: milestone 2 FAILED\n");
+		goto out;
+	}
+	printf("SURYA TOUCH: milestone 2 PASSED\n");
+	surya_touch_loop();
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * surya power off / restart. It lives here only because this file is the one
+ * surya driver that is already started at boot; it is not touch code.
+ * Without a platform PE_halt_restart, IOPlatformExpert::haltRestart returns
+ * -1 and halt_all_cpus() spins forever: iOS "Shut Down" froze the screen and
+ * drained the battery to empty. PSCI 1.1 via SMC is what the Qualcomm TZ
+ * offers (CPU_ON already used by the SMP patch; SYSTEM_RESET used by the shim).
+ * By the time halt is requested launchd has synced the volumes, and HFS's
+ * DKIOCSYNCHRONIZE makes sweet_ufs send SYNCHRONIZE CACHE(10); power is cut
+ * 3 s later as a margin.
+ */
+#define PSCI_SYSTEM_OFF   0x84000008ULL
+#define PSCI_SYSTEM_RESET 0x84000009ULL
+
+static int32_t
+surya_psci(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+static void surya_lights_off(void);
+static void surya_vib_off(void);
+
+static int
+surya_halt_restart(unsigned int type)
+{
+	uint64_t fn;
+	if (type == kPEHaltCPU || type == kPEUPSDelayHaltCPU || type == kPERestartCPU ||
+	    type == kPEPanicRestartCPU) {
+		surya_lights_off(); /* PMIC blocks keep their state over a warm reset */
+		if (type != kPEPanicRestartCPU) {
+			surya_vib_off(); /* after a panic its thread may not run; reset stops it */
+		}
+	}
+	switch (type) {
+	case kPEHaltCPU:
+	case kPEUPSDelayHaltCPU:
+		printf("SURYA POWER: halt -> PSCI SYSTEM_OFF in 3 s\n");
+		delay(3000000);
+		fn = PSCI_SYSTEM_OFF;
+		break;
+	case kPERestartCPU:
+		printf("SURYA POWER: restart -> PSCI SYSTEM_RESET in 3 s\n");
+		delay(3000000);
+		fn = PSCI_SYSTEM_RESET;
+		break;
+	case kPEPanicRestartCPU:
+		/* Keep the panic visible in the logs and on screen for a while. */
+		printf("SURYA POWER: panic -> PSCI SYSTEM_RESET in 30 s\n");
+		delay(30000000);
+		fn = PSCI_SYSTEM_RESET;
+		break;
+	default:
+		return 0; /* panic callouts, paging off: nothing to do here */
+	}
+	int32_t rc = surya_psci(fn);
+	printf("SURYA POWER: PSCI %#llx returned %d\n", (unsigned long long)fn, rc);
+	return -1;
+}
+
+static void
+surya_power_init(void)
+{
+	DTEntry node;
+	int on = 1;
+	(void)PE_parse_boot_argn("suryapower", &on, sizeof(on));
+	/* /surya-touch exists only in surya's locally built ADT. */
+	if (!on || PE_halt_restart ||
+	    SecureDTLookupEntry(NULL, "/surya-touch", &node) != kSuccess) {
+		return;
+	}
+	PE_halt_restart = surya_halt_restart;
+	printf("SURYA POWER: shut down and restart through PSCI\n");
+}
+
+/*
+ * surya wall clock (not touch code either; this file is surya's C home).
+ * The PM6150 RTC runs (seconds since about the first power-on in 2020), but
+ * its write channel is not owned by APPS, and Linux on surya never writes it
+ * (qpnp-rtc-write = 0): Android kept an offset in /data. Here the offset is
+ * kept in SURYA_TIME_FILE on the iOS root, by the user's choice (21.10):
+ *  - SweetPlatformExpert::setGMTTimeOfDay -> surya_time_set: iOS set the time,
+ *    store offset = time - RTC with the RTC value it was taken at;
+ *  - surya_time_tick, from SweetBattery's 1 s timer until it is done: once the
+ *    root is mounted, read the file and set the calendar to RTC + offset.
+ *    Until then (clock_initialize_calendar runs before the root is mounted)
+ *    surya_time_get answers 0, as before. An RTC behind the saved value means
+ *    the RTC was reset; the offset is then dropped.
+ *  - boot-arg suryatime=<PC epoch>, patched into the image right before
+ *    fastboot boot (scripts/boot-with-time.sh): the Settings "Date & Time"
+ *    page hangs on this port (21.10), so the PC can set the time instead.
+ *    Time = suryatime + SURYA_TIME_LAG (fastboot transfer and start, about
+ *    7 s) + RTC seconds since the first clock read; then saved as above.
+ */
+#define SURYA_TIME_FILE  "/private/var/db/surya-time"
+#define SURYA_TIME_MAGIC 0x53525443u /* "SRTC" */
+#define SURYA_TIME_LAG   7u
+
+struct surya_time_rec {
+	uint32_t magic, version;
+	int64_t offset;
+	uint32_t rtc, reserved;
+};
+
+static int64_t surya_offset;
+static bool surya_offset_valid, surya_time_done, surya_time_restoring;
+static uint32_t surya_rtc_first; /* RTC at the first clock read, for suryatime */
+
+long surya_time_get(void);
+void surya_time_set(long secs);
+int surya_time_tick(void);
+
+/* RTC_READ 0x6048..0x604b, re-read byte 0 for rollover (qpnp_rtc_read_time). */
+static uint32_t
+surya_rtc_now(void)
+{
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		uint8_t b[4], again;
+		bool ok = true;
+		for (unsigned i = 0; i < 4 && ok; ++i) {
+			ok = !sweet_spmi_read(0, 0x6048u + i, &b[i]);
+		}
+		if (!ok || sweet_spmi_read(0, 0x6048u, &again)) {
+			return 0xffffffffu;
+		}
+		if (again >= b[0]) {
+			return (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) |
+			       ((uint32_t)b[3] << 24);
+		}
+	}
+	return 0xffffffffu;
+}
+
+/* Small kernel-owned state files under /private/var/db (time, backlight). */
+int surya_db_rw(const char *path, int write, void *buf, int len);
+int surya_root_ready(void);
+
+int
+surya_root_ready(void)
+{
+	return rootvnode != NULLVP;
+}
+
+int
+surya_db_rw(const char *path, int write, void *buf, int len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int fmode = write ? (O_CREAT | O_TRUNC | FWRITE) : FREAD;
+	int resid = 0;
+	if (!rootvnode) {
+		return ENOENT;
+	}
+	int err = vnode_open(path, fmode, 0600, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	err = vn_rdwr(write ? UIO_WRITE : UIO_READ, vp, (caddr_t)buf, len, 0,
+	    UIO_SYSSPACE, IO_NOAUTH | (write ? IO_SYNC : 0), vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	(void)vnode_close(vp, write ? FWRITE : FREAD, ctx);
+	return err ? err : (resid ? EIO : 0);
+}
+
+static int
+surya_time_file(bool write, struct surya_time_rec *rec)
+{
+	return surya_db_rw(SURYA_TIME_FILE, write, rec, (int)sizeof(*rec));
+}
+
+long
+surya_time_get(void)
+{
+	uint32_t rtc = surya_rtc_now();
+	if (rtc != 0xffffffffu && !surya_rtc_first) {
+		surya_rtc_first = rtc;
+	}
+	if (rtc == 0xffffffffu || !surya_offset_valid) {
+		return 0;
+	}
+	return (long)((int64_t)rtc + surya_offset);
+}
+
+void
+surya_time_set(long secs)
+{
+	uint32_t rtc = surya_rtc_now();
+	if (rtc == 0xffffffffu || secs <= 0) {
+		return;
+	}
+	surya_offset = (int64_t)secs - rtc;
+	surya_offset_valid = true;
+	if (surya_time_restoring) {
+		return; /* our own clock_set_calendar_microtime below */
+	}
+	struct surya_time_rec rec = {SURYA_TIME_MAGIC, 1, surya_offset, rtc, 0};
+	int err = rootvnode ? surya_time_file(true, &rec) : ENOENT;
+	printf("SURYA TIME: set %ld (rtc %u, offset %lld), saved err=%d\n",
+	    secs, rtc, (long long)surya_offset, err);
+}
+
+int
+surya_time_tick(void)
+{
+	if (surya_time_done) {
+		return 1;
+	}
+	if (!rootvnode) {
+		return 0;
+	}
+	surya_time_done = true;
+	unsigned long long pc = 0;
+	uint32_t now = surya_rtc_now();
+	if (PE_parse_boot_argn("suryatime", &pc, sizeof(pc)) && pc > 1600000000ULL &&
+	    now != 0xffffffffu && surya_rtc_first && now >= surya_rtc_first) {
+		long secs = (long)(pc + SURYA_TIME_LAG + (now - surya_rtc_first));
+		surya_time_set(secs); /* offset + file */
+		surya_time_restoring = true;
+		clock_set_calendar_microtime((clock_sec_t)secs, 0);
+		surya_time_restoring = false;
+		printf("SURYA TIME: from boot-arg %llu + %u + %u s -> %ld\n", pc, SURYA_TIME_LAG,
+		    now - surya_rtc_first, secs);
+		return 1;
+	}
+	struct surya_time_rec rec;
+	bzero(&rec, sizeof(rec));
+	int err = surya_time_file(false, &rec);
+	uint32_t rtc = surya_rtc_now();
+	if (err || rec.magic != SURYA_TIME_MAGIC || rec.version != 1 || rtc == 0xffffffffu) {
+		printf("SURYA TIME: no saved time (err=%d magic=%#x rtc=%u)\n", err, rec.magic, rtc);
+		return 1;
+	}
+	if (rtc < rec.rtc) {
+		printf("SURYA TIME: RTC went back (%u < %u): saved offset dropped\n", rtc, rec.rtc);
+		return 1;
+	}
+	surya_offset = rec.offset;
+	surya_offset_valid = true;
+	long secs = (long)((int64_t)rtc + surya_offset);
+	surya_time_restoring = true;
+	clock_set_calendar_microtime((clock_sec_t)secs, 0);
+	surya_time_restoring = false;
+	printf("SURYA TIME: restored %ld (rtc %u + offset %lld)\n", secs, rtc,
+	    (long long)surya_offset);
+	return 1;
+}
+
+/*
+ * surya: what follows the display state. SweetFramebuffer calls
+ * surya_display_power() on iOS RequestPowerChange (display off on lock or
+ * auto-lock, on again). Users: double tap to wake, the torch on a long
+ * volume-down press, the notification LED. Like the power and clock code
+ * above, this lives here because this file is surya's C home.
+ */
+static volatile int surya_disp_on = 1;
+
+void surya_display_power(int on);
+int surya_display_is_on(void);
+
+void
+surya_display_power(int on)
+{
+	surya_disp_on = on;
+}
+
+int
+surya_display_is_on(void)
+{
+	return surya_disp_on;
+}
+
+/*
+ * Double tap to wake: with the display off, two short taps of one finger,
+ * the second starting at most 400 ms after the first ended and within 150 px
+ * of it, press the power key for iOS (the key path of the hardware button).
+ * Found in the ordinary touch reports: the controller keeps scanning while the
+ * display is off. Novatek's own gesture mode (0x13 to EVENT_MAP_HOST_CMD, as
+ * nvt_ts_suspend) needs a firmware download after every display on; it is
+ * left for the battery work. Boot-arg suryadoubletap=0 turns this off.
+ */
+#define SURYA_TAP_MAX_NS 300000000ULL /* one tap, finger down to up */
+#define SURYA_TAP_GAP_NS 400000000ULL /* first tap up to second tap down */
+#define SURYA_TAP_MOVE   60           /* px a tap may wander */
+#define SURYA_TAP_DIST   150          /* px between the two taps */
+
+static struct {
+	int enabled;    /* -1: boot-arg not read yet */
+	bool down, moved, first;
+	uint64_t t_down, t_up;
+	int x0, y0, fx, fy;
+} stap = { .enabled = -1 };
+
+static uint64_t
+surya_now_ns(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+static int
+surya_iabs(int v)
+{
+	return v < 0 ? -v : v;
+}
+
+static void
+surya_tap_track(uint32_t now, const int *x, const int *y)
+{
+	if (stap.enabled < 0) {
+		stap.enabled = 1;
+		(void)PE_parse_boot_argn("suryadoubletap", &stap.enabled, sizeof(stap.enabled));
+	}
+	if (!stap.enabled || surya_disp_on) {
+		stap.down = false;
+		stap.first = false;
+		return;
+	}
+	uint64_t t = surya_now_ns();
+	if (now) {
+		unsigned i = (unsigned)__builtin_ctz(now);
+		if (!stap.down) {
+			stap.down = true;
+			stap.moved = __builtin_popcount(now) > 1;
+			stap.t_down = t;
+			stap.x0 = x[i];
+			stap.y0 = y[i];
+			if (stap.first && t - stap.t_up > SURYA_TAP_GAP_NS) {
+				stap.first = false;
+			}
+		} else if (__builtin_popcount(now) > 1 || surya_iabs(x[i] - stap.x0) > SURYA_TAP_MOVE ||
+		    surya_iabs(y[i] - stap.y0) > SURYA_TAP_MOVE) {
+			stap.moved = true;
+		}
+		return;
+	}
+	if (!stap.down) {
+		return;
+	}
+	stap.down = false;
+	if (stap.moved || t - stap.t_down > SURYA_TAP_MAX_NS) {
+		stap.first = false;
+		return;
+	}
+	if (stap.first && surya_iabs(stap.x0 - stap.fx) <= SURYA_TAP_DIST &&
+	    surya_iabs(stap.y0 - stap.fy) <= SURYA_TAP_DIST) {
+		stap.first = false;
+		printf("SURYA TAP: double tap at %d,%d -> power key\n", stap.x0, stap.y0);
+		sweet_hid_key(0, 1);
+		sweet_hid_key(0, 0);
+		return;
+	}
+	stap.first = true;
+	stap.fx = stap.x0;
+	stap.fy = stap.y0;
+	stap.t_up = t;
+}
+
+/*
+ * Torch: both PM6150L flash LEDs (SID 5, block 0xd300) in torch mode, 150 mA
+ * each (sm7150-mainline's per-LED limit; Xiaomi's torch nodes say 300 mA, the
+ * module allows 500), with the sequence of Linux leds-qcom-flash.c
+ * (qcom_flash_led_brightness_set, torch): software strobe, current in 5 mA
+ * steps, safety timer off, module on, channels on. The module is checked
+ * first (type 0x18, a known subtype, write channel owned by APPS) and the
+ * torch clamp set once. A long volume-down press (800 ms) switches it while
+ * the display is off, or off whenever it is on (the user's choice, 21.10).
+ */
+#define SURYA_TORCH_CODE 0x1d   /* 150 mA = (29 + 1) * 5 mA */
+
+static int surya_torch_ok = -1; /* -1 unchecked, 0 unusable, 1 usable */
+static int surya_torch_on;
+
+static int
+surya_torch_check(void)
+{
+	if (surya_torch_ok >= 0) {
+		return surya_torch_ok;
+	}
+	uint8_t type = 0xee, subtype = 0xee;
+	unsigned apid = 0;
+	int owner = sweet_spmi_owner(5, 0xd3, &apid);
+	int err = sweet_spmi_read(5, 0xd304, &type);
+	err |= sweet_spmi_read(5, 0xd305, &subtype);
+	surya_torch_ok = !err && owner == 0 && type == 0x18 &&
+	    (subtype == 0x03 || subtype == 0x04 || subtype == 0x07);
+	int clamp = surya_torch_ok ? sweet_spmi_write(5, 0xd3ec, 0x63) : -1; /* 500 mA */
+	printf("SURYA TORCH: flash block type %#x subtype %#x apid %u owner %d, clamp %s -> %s\n",
+	    type, subtype, apid, owner, clamp ? "not set" : "500 mA",
+	    surya_torch_ok ? "usable" : "NOT usable");
+	return surya_torch_ok;
+}
+
+static int
+surya_torch_set(int on)
+{
+	if (!surya_torch_check()) {
+		return -1;
+	}
+	int err = 0;
+	if (on) {
+		err |= sweet_spmi_write(5, 0xd349, 0x01); /* CHAN_STROBE: software, level, high */
+		err |= sweet_spmi_write(5, 0xd34a, 0x01);
+		err |= sweet_spmi_write(5, 0xd34c, 0x00); /* CHAN_EN off while configuring */
+		err |= sweet_spmi_write(5, 0xd346, 0x00); /* MODULE_EN off */
+		err |= sweet_spmi_write(5, 0xd343, SURYA_TORCH_CODE); /* ITARGET */
+		err |= sweet_spmi_write(5, 0xd344, SURYA_TORCH_CODE);
+		err |= sweet_spmi_write(5, 0xd347, 0x0f); /* IRESOLUTION: 5 mA, channels 0 and 1 */
+		err |= sweet_spmi_write(5, 0xd340, 0x00); /* CHAN_TIMER off */
+		err |= sweet_spmi_write(5, 0xd341, 0x00);
+		err |= sweet_spmi_write(5, 0xd346, 0x80); /* MODULE_EN */
+		err |= sweet_spmi_write(5, 0xd34c, 0x03); /* CHAN_EN: channels 0 and 1 */
+	} else {
+		err |= sweet_spmi_write(5, 0xd34c, 0x00);
+		err |= sweet_spmi_write(5, 0xd346, 0x00);
+	}
+	uint8_t st[3] = {0xee, 0xee, 0xee};
+	for (unsigned i = 0; i < 3; ++i) {
+		(void)sweet_spmi_read(5, 0xd308 + i, &st[i]);
+	}
+	surya_torch_on = on && !err;
+	printf("SURYA TORCH: %s%s, status %02x %02x %02x\n", on ? "on" : "off",
+	    err ? " FAILED" : "", st[0], st[1], st[2]);
+	return err ? -1 : 0;
+}
+
+/* Called by sweet_keys' 20 ms poll with the current key states (0 power,
+ * 1 volume up, 2 volume down). */
+void surya_keys_poll(const int now[3]);
+
+static void surya_led_test_step(void);
+
+void
+surya_keys_poll(const int now[3])
+{
+	static unsigned held, held_up;
+	static bool fired, fired_up;
+	/* volume up held 800 ms with the display off: next LED test step */
+	if (!now[1]) {
+		held_up = 0;
+		fired_up = false;
+	} else if (++held_up >= 40 && !fired_up) {
+		fired_up = true;
+		if (!surya_disp_on) {
+			surya_led_test_step();
+		}
+	}
+	if (!now[2]) {
+		held = 0;
+		fired = false;
+		return;
+	}
+	if (++held >= 40 && !fired) {
+		fired = true;
+		if (!surya_disp_on || surya_torch_on) {
+			(void)surya_torch_set(!surya_torch_on);
+		}
+	}
+}
+
+/*
+ * Notification LED: white, PM6150L LPG channel 0 (SID 5, 0xb100) through the
+ * TRILED block (0xd000, bit 7), as Linux leds-qcom-lpg.c (pm8150l_lpg_data)
+ * in PWM mode (lpg_apply): 9-bit PWM from 19.2 MHz / 5 / 2^3, a 1.07 ms
+ * period, duty = value / 512, glitch removal off while it changes, the value
+ * written again after the output is enabled (LPG erratum), then sync. Until
+ * iOS notifications reach it (an own service, later) the battery timer drives
+ * it: steady while charging with the display off, blinking below 15 % on
+ * battery with the display off.
+ */
+#define SURYA_LED_DUTY 128      /* of 512 */
+
+static int surya_led_ok = -1;
+static unsigned surya_led_duty;
+static uint8_t surya_led_size;  /* LPG_SIZE_CLK resolution bits for the subtype */
+
+static int
+surya_led_check(void)
+{
+	if (surya_led_ok >= 0) {
+		return surya_led_ok;
+	}
+	uint8_t type = 0xee, subtype = 0xee, en = 0xee, ttype = 0xee, tsub = 0xee;
+	unsigned lapid = 0, tapid = 0;
+	int lown = sweet_spmi_owner(5, 0xb1, &lapid), town = sweet_spmi_owner(5, 0xd0, &tapid);
+	int err = sweet_spmi_read(5, 0xb104, &type);
+	err |= sweet_spmi_read(5, 0xb105, &subtype);
+	err |= sweet_spmi_read(5, 0xd046, &en);
+	(void)sweet_spmi_read(5, 0xd004, &ttype);
+	(void)sweet_spmi_read(5, 0xd005, &tsub);
+	printf("SURYA LED: triled type %#x subtype %#x (Xiaomi: type 0x19; subtype 0x03 LED2H0L12 "
+	    "needs a PBS trigger), lpg ch1/ch2 owners %d/%d\n", ttype, tsub,
+	    sweet_spmi_owner(5, 0xb2, NULL), sweet_spmi_owner(5, 0xb3, NULL));
+	/* surya reads subtype 0x11, LPG_SUBTYPE_LPG_LITE (21.10); the full LPG is 0x02. */
+	surya_led_ok = !err && lown == 0 && town == 0 && (subtype == 0x11 || subtype == 0x02);
+	surya_led_size = subtype == 0x02 ? 0x30 : 0x10; /* lpg_apply_freq: LPG GENMASK(5,4), Lite BIT(4) */
+	printf("SURYA LED: lpg type %#x subtype %#x apid %u owner %d, triled en %#x apid %u owner %d -> %s\n",
+	    type, subtype, lapid, lown, en, tapid, town, surya_led_ok ? "usable" : "NOT usable");
+	return surya_led_ok;
+}
+
+/*
+ * One LPG channel (0..2 = TRILED red/green/blue; surya's white LED is "red",
+ * label "white" in Xiaomi's pm6150l.dtsi) on or off. Each change reads the
+ * registers back into the log (the first 60): on 21.10 every write succeeded
+ * but the LED stayed dark, so the log must show what the hardware holds.
+ */
+static int
+surya_led_chan(unsigned ch, unsigned duty)
+{
+	unsigned b = 0xb100u + 0x100u * ch;
+	uint8_t bit = (uint8_t)(0x80u >> ch);
+	int err = 0;
+	if (duty) {
+		uint8_t tc = 0;
+		err |= sweet_spmi_read(5, b + 0x43, &tc);
+		err |= sweet_spmi_write(5, b + 0x43, (uint8_t)(tc | 0x20u));  /* glitch removal off */
+		err |= sweet_spmi_write(5, b + 0x41, (uint8_t)(0x03u | surya_led_size)); /* 19.2 MHz */
+		err |= sweet_spmi_write(5, b + 0x42, 0x43);                   /* pre-divide 5, 2^3 */
+		err |= sweet_spmi_write(5, b + 0x44, (uint8_t)(duty & 0xffu));
+		err |= sweet_spmi_write(5, b + 0x45, (uint8_t)(duty >> 8));
+		err |= sweet_spmi_write(5, b + 0x46, 0xa4);                   /* output, tristate, PWM */
+		err |= sweet_spmi_write(5, b + 0x44, (uint8_t)(duty & 0xffu));
+		err |= sweet_spmi_write(5, b + 0x45, (uint8_t)(duty >> 8));
+		err |= sweet_spmi_write(5, b + 0x47, 0x01);                   /* sync */
+		err |= sweet_spmi_write(5, b + 0x43, (uint8_t)(tc & ~0x20u)); /* glitch removal on */
+		err |= sweet_spmi_write(5, 0xd046, bit);                      /* TRILED channel */
+	} else {
+		err |= sweet_spmi_write(5, 0xd046, 0x00);
+		err |= sweet_spmi_write(5, b + 0x46, 0x24);
+	}
+	static unsigned logged;
+	if (logged < 60) {
+		++logged;
+		uint8_t r[9];
+		static const uint8_t off[7] = {0x08, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46};
+		for (unsigned i = 0; i < 7; ++i) {
+			r[i] = 0xee;
+			(void)sweet_spmi_read(5, b + off[i], &r[i]);
+		}
+		r[7] = r[8] = 0xee;
+		(void)sweet_spmi_read(5, 0xd008, &r[7]);
+		(void)sweet_spmi_read(5, 0xd046, &r[8]);
+		printf("SURYA LED: ch %u duty %u%s | sts %02x size %02x prediv %02x type %02x "
+		    "val %02x%02x en %02x | triled sts %02x en %02x\n", ch, duty, err ? " FAILED" : "",
+		    r[0], r[1], r[2], r[3], r[5], r[4], r[6], r[7], r[8]);
+	}
+	return err ? -1 : 0;
+}
+
+static int
+surya_led_set(unsigned duty)
+{
+	if (duty == surya_led_duty || !surya_led_check()) {
+		return 0;
+	}
+	if (surya_led_chan(0, duty)) {
+		surya_led_ok = 0;
+		return -1;
+	}
+	surya_led_duty = duty;
+	return 0;
+}
+
+/*
+ * LED test on demand (21.10: two boot-time tests went unseen): each long
+ * volume-up press with the display off moves to the next step, channel 0, 1,
+ * 2 at 100 %, then off and back to normal control. Every step is logged with
+ * the registers read back.
+ */
+static volatile unsigned surya_led_testing; /* 0 normal; 1..3 = channel + 1 lit */
+
+static void
+surya_led_test_step(void)
+{
+	if (!surya_led_check()) {
+		printf("SURYA LED: test refused, LED not usable\n");
+		return;
+	}
+	unsigned step = surya_led_testing;
+	if (step) {
+		(void)surya_led_chan(step - 1u, 0);
+	} else if (surya_led_duty) {
+		(void)surya_led_chan(0, 0);
+		surya_led_duty = 0;
+	}
+	step = step >= 3u ? 0u : step + 1u;
+	if (step) {
+		(void)surya_led_chan(step - 1u, 511);
+	}
+	surya_led_testing = step;
+	printf("SURYA LED: test step %u (%s)\n", step,
+	    step ? (step == 1 ? "channel 0 = white" : step == 2 ? "channel 1" : "channel 2") : "off");
+}
+
+/* Every second from SweetBattery's timer, with the last published state. */
+void surya_led_tick(int external, int charging, unsigned percent);
+
+void
+surya_led_tick(int external, int charging, unsigned percent)
+{
+	static unsigned tick;
+	static int test = -1;
+	++tick;
+	if (test < 0) {
+		test = 0;
+		(void)PE_parse_boot_argn("suryaledtest", &test, sizeof(test));
+	}
+	unsigned want = 0;
+	if (surya_led_testing) {
+		return; /* a volume-up test step owns the LED */
+	}
+	if (test == 2 && tick <= 16) {
+		/* suryaledtest=2: channels 0, 1, 2 at 100 % for 5 s each, then off. */
+		if (surya_led_check() && (tick == 1 || tick == 6 || tick == 11 || tick == 16)) {
+			unsigned ch = (tick - 1u) / 5u;
+			if (ch > 0) {
+				(void)surya_led_chan(ch - 1u, 0);
+			}
+			if (ch < 3) {
+				(void)surya_led_chan(ch, 511);
+			}
+		}
+		return;
+	}
+	if (test == 1 && tick <= 20) {
+		want = (tick & 1u) ? SURYA_LED_DUTY : 0; /* suryaledtest=1: 10 blinks at start */
+	} else if (!surya_disp_on) {
+		if (charging) {
+			want = SURYA_LED_DUTY;
+		} else if (!external && percent && percent < 15) {
+			want = (tick & 1u) ? SURYA_LED_DUTY : 0;
+		}
+	}
+	(void)surya_led_set(want);
+}
+
+/*
+ * Vibration: Awinic AW8624 on GENI SE1 in I2C mode (qupv3_se1_i2c, 0x884000),
+ * address 0x5a, 400 kHz (surya's DT gives no rate: i2c-qcom-geni's default).
+ * Facts from surya's dtbo (fragment 60) and Xiaomi surya-q-oss aw8624.c:
+ *  - SDA/SCL gpio0/1, function qup01, SOUTH tile, 2 mA, no pull; reset gpio63
+ *    (NORTH, low 5 ms then high); interrupt gpio26 (SOUTH, input, pull-up),
+ *    not used: status is polled.
+ *  - CONT mode (aw8624_haptic_cont): the chip drives the motor at its own
+ *    resonance from the back-EMF zero crossings, so no waveform file is needed
+ *    (Xiaomi's RAM waves, aw8624_haptic.bin, stay out of this tree). f0 preset
+ *    205.0 Hz; f0 calibrated once at start as aw8624_haptic_f0_calibration,
+ *    a short buzz while the chip measures the motor.
+ *  - Patterns come from iOS through SweetBattery's "vibrator" service
+ *    (FigVibrator_IOKit): pairs of intensity (16.16, 0 = off) and milliseconds,
+ *    played by one thread; intensity scales the CONT drive level.
+ * Boot-arg suryavib=0 leaves the chip alone.
+ */
+#define SURYA_VIB_SE_PA    0x00884000u
+#define SURYA_SOUTH_PA     0x03d00000u /* DT TLMM + SOUTH (0x900000) */
+#define SURYA_VIB_RCG      0x17164u    /* wrapper0 S1 */
+#define SURYA_VIB_VOTE     ((0x0fu << 6) | (1u << 11)) /* wrap0 m_ahb, s_ahb, core, core_2x, S1 */
+#define SURYA_VIB_ADDR     0x5au
+#define SURYA_VIB_RST_GPIO 63u
+#define SURYA_VIB_IRQ_GPIO 26u
+#define SURYA_VIB_MAX_SEG  64u
+#define SURYA_VIB_CAP_NS   120000000000ULL /* a pattern nobody stopped ends after 120 s */
+
+/* aw8624_reg.h */
+#define AW_ID           0x00
+#define AW_SYSINT       0x02
+#define AW_SYSINTM      0x03
+#define AW_SYSCTRL      0x04
+#define AW_GO           0x05
+#define AW_DATCTRL      0x2b
+#define AW_PWMPRC       0x2d
+#define AW_PWMDBG       0x2e
+#define AW_WAVECTRL     0x31
+#define AW_ANACTRL      0x38
+#define AW_SW_BRAKE     0x39
+#define AW_PRLVL        0x3e
+#define AW_GLB_STATE    0x47
+#define AW_CONT_CTRL    0x48
+#define AW_F_PRE_H      0x49
+#define AW_F_PRE_L      0x4a
+#define AW_TD_H         0x4b
+#define AW_TD_L         0x4c
+#define AW_TSET         0x4d
+#define AW_THRS_BRA_END 0x4f
+#define AW_EF_RDATAH    0x55
+#define AW_TRIM_LRA     0x5b
+#define AW_R_SPARE      0x5d
+#define AW_DETCTRL      0x5f
+#define AW_ADCTEST      0x66
+#define AW_F_LRA_F0_H   0x68
+#define AW_F_LRA_F0_L   0x69
+#define AW_WAIT_VOL_MP  0x6e
+#define AW_WAIT_VOL_MN  0x6f
+#define AW_ZC_THRSH_H   0x72
+#define AW_ZC_THRSH_L   0x73
+#define AW_BEMF_VTHH_H  0x74
+#define AW_BEMF_NUM     0x78
+#define AW_TIME_NZC     0x7a
+#define AW_DRV_LVL      0x7b
+#define AW_DRV_LVL_OV   0x7c
+#define AW_NUM_F0_1     0x7d
+#define AW_NUM_F0_2     0x7e
+#define AW_NUM_F0_3     0x7f
+
+/* surya dtbo haptic@5A */
+#define AW_V_F0_PRE     2050u   /* vib_f0_pre, 0.1 Hz */
+#define AW_V_F0_COEFF   260u    /* vib_f0_coeff */
+#define AW_V_CALI_PCT   7       /* vib_f0_cali_percen */
+#define AW_V_DRV_LVL    0x64u   /* vib_cont_drv_lev */
+#define AW_V_DRV_LVL_OV 0x69u   /* vib_cont_drv_lvl_ov */
+#define AW_V_TD         0xf06cu /* vib_cont_td */
+#define AW_V_ZC_THR     0x08f8u /* vib_cont_zc_thr */
+#define AW_V_NUM_BRK    0x03u   /* vib_cont_num_brk */
+#define AW_V_SW_BRAKE   0x2cu   /* vib_sw_brake */
+#define AW_V_TSET       0x11u   /* vib_tset */
+static const uint8_t aw_bemf[4] = {0x10, 0x08, 0x23, 0xf8};  /* vib_bemf_config */
+static const uint8_t aw_trace[4] = {0x09, 0x05, 0x01, 0x0f}; /* vib_f0_trace_parameter */
+
+static struct {
+	vm_offset_t se, gcc, north, south;
+	bool dead;
+	int chipid_flag;
+	uint8_t trim;
+	int level;          /* drive level now: 0 stopped, -1 unknown after an error */
+	unsigned retries, changes;
+	IOLock *lock;       /* guards the pattern below, written by surya_vib_play */
+	uint32_t seg[2 * SURYA_VIB_MAX_SEG];
+	unsigned nseg, gen;
+	bool repeat;
+	int pid;            /* who sent the pattern */
+	unsigned samples;
+} svib;
+static int svib_chan;
+
+extern task_t proc_task(proc_t);
+extern void sweet_sample_task(const char *name, int pid, task_t task); /* osfmk/kern/exception.c */
+
+static void
+surya_vib_abort(void)
+{
+	touch_wr(svib.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (touch_rd(svib.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !touch_wait_clear(svib.se, SE_STATUS, 1u)) {
+		svib.dead = true;
+		printf("SURYA VIB: abort failed status=%#x irq=%#x; stopping\n",
+		    touch_rd(svib.se, SE_STATUS), touch_rd(svib.se, SE_IRQ));
+	}
+	for (unsigned i = 0; i < 64 && (touch_rd(svib.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)touch_rd(svib.se, SE_RX);
+	}
+	touch_wr(svib.se, SE_IRQ_CLR, 0xffffffffu);
+	if (touch_rd(svib.se, SE_TX_COUNT) & 0xfffffffu) {
+		svib.dead = true;
+		printf("SURYA VIB: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* One FIFO message on SE1, as touch_msg_run: TX of at most 3 bytes, or RX of at most 4. */
+static int
+surya_vib_msg(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	unsigned sent = 0, got = 0;
+	if (svib.dead || nt > 3 || nr > 4 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(svib.se, SE_STATUS, 1u)) {
+		svib.dead = true; /* no other SE1 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(svib.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(svib.se, SE_TX_WM, nt ? 1u : 0u);
+	touch_wr(svib.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	touch_wr(svib.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)SURYA_VIB_ADDR << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_rd(svib.se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = touch_rd(svib.se, SE_IRQ);
+			}
+			if ((irq & SE_DONE) && !(touch_rd(svib.se, SE_STATUS) & 1u) &&
+			    !(touch_rd(svib.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(touch_rd(svib.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				touch_wr(svib.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			touch_wr(svib.se, SE_TX, word);
+			sent = nt;
+			touch_wr(svib.se, SE_TX_WM, 0);
+		}
+		uint32_t count = touch_rd(svib.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > (nr - got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(svib.se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if (irq & SE_DONE) {
+			irq = touch_rd(svib.se, SE_IRQ);
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			touch_wr(svib.se, SE_IRQ_CLR, irq);
+			if (got == nr && sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		touch_wr(svib.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	surya_vib_abort();
+	return err;
+}
+
+/* aw8624_i2c_write / _read, which also retry a failed transfer. */
+static int
+aw_wr(uint8_t reg, uint8_t val)
+{
+	const uint8_t buf[2] = {reg, val};
+	int err = EIO;
+	for (unsigned i = 0; i < 3 && err && !svib.dead; ++i) {
+		svib.retries += i ? 1u : 0u;
+		err = surya_vib_msg(buf, 2, NULL, 0, false);
+	}
+	return err;
+}
+
+static int
+aw_rd(uint8_t reg, uint8_t *val)
+{
+	int err = EIO;
+	for (unsigned i = 0; i < 3 && err && !svib.dead; ++i) {
+		svib.retries += i ? 1u : 0u;
+		/* STOP_STRETCH on the pointer write keeps the bus for a repeated START. */
+		err = surya_vib_msg(&reg, 1, NULL, 0, true);
+		if (!err) {
+			err = surya_vib_msg(NULL, 0, val, 1, false);
+		}
+	}
+	return err;
+}
+
+/* aw8624_i2c_write_bits, with the bits to clear named positively. */
+static int
+aw_bits(uint8_t reg, uint8_t clear, uint8_t set)
+{
+	uint8_t v = 0;
+	int err = aw_rd(reg, &v);
+	return err ? err : aw_wr(reg, (uint8_t)((v & ~clear) | set));
+}
+
+/* aw8624_haptic_play_mode(STANDBY): UVLO interrupt off, standby. */
+static int
+aw_standby(void)
+{
+	int err = aw_bits(AW_SYSINTM, 0x20, 0x20);
+	return err | aw_bits(AW_SYSCTRL, 0x01, 0x01);
+}
+
+/* aw8624_haptic_play_mode(CONT) with aw8624_haptic_active. */
+static int
+aw_cont_mode(void)
+{
+	uint8_t v = 0;
+	int err = aw_bits(AW_SYSCTRL, 0x0c, 0x08); /* play mode CONT */
+	err |= aw_bits(AW_SYSCTRL, 0x01, 0x00);    /* active */
+	err |= aw_rd(AW_SYSINT, &v);               /* interrupt_clear: reading clears */
+	err |= aw_bits(AW_SYSINTM, 0x20, 0x00);    /* UVLO interrupt on */
+	return err;
+}
+
+/* aw8624_haptic_stop: GO off once, wait for GLB_STATE 0, then standby. */
+static int
+aw_stop(void)
+{
+	bool go_off = false;
+	uint8_t s = 0xff;
+	for (unsigned i = 0; i < 60; ++i) {
+		int err = aw_rd(AW_GLB_STATE, &s);
+		if (err) {
+			return err;
+		}
+		if (s == 0) {
+			return aw_standby();
+		}
+		if (s > 3 && !go_off) { /* 1..3: bringing up; above: playing */
+			go_off = true;
+			if ((err = aw_bits(AW_GO, 0x01, 0x00))) {
+				return err;
+			}
+		}
+		touch_wait(2);
+	}
+	printf("SURYA VIB: no standby after 120 ms (state %#x)\n", s);
+	return aw_standby();
+}
+
+static int
+aw_f0_preset(void)
+{
+	unsigned f0_reg = 1000000000u / (AW_V_F0_PRE * AW_V_F0_COEFF);
+	int err = aw_wr(AW_F_PRE_H, (uint8_t)(f0_reg >> 8));
+	return err | aw_wr(AW_F_PRE_L, (uint8_t)f0_reg);
+}
+
+/* aw8624_haptic_cont at drive level `level` (the work routine first loads the
+ * calibrated trim and stops whatever plays). */
+static int
+aw_cont_start(unsigned level)
+{
+	int err = aw_wr(AW_TRIM_LRA, svib.trim);
+	err |= aw_stop();
+	err |= aw_cont_mode();
+	err |= aw_f0_preset();
+	err |= aw_bits(AW_DATCTRL, 0xe0, 0xe0); /* LPF 1000 Hz (bits 7:6), LPF on */
+	/* zero cross detect, wait 1 period, run while GO, closed loop, no f0
+	 * detect, no O2C, auto brake */
+	err |= aw_wr(AW_CONT_CTRL, 0x89);
+	err |= aw_wr(AW_TD_H, (uint8_t)(AW_V_TD >> 8));
+	err |= aw_wr(AW_TD_L, (uint8_t)AW_V_TD);
+	err |= aw_wr(AW_TSET, AW_V_TSET);
+	err |= aw_wr(AW_ZC_THRSH_H, (uint8_t)(AW_V_ZC_THR >> 8));
+	err |= aw_wr(AW_ZC_THRSH_L, (uint8_t)AW_V_ZC_THR);
+	err |= aw_bits(AW_BEMF_NUM, 0x0f, AW_V_NUM_BRK);
+	err |= aw_wr(AW_TIME_NZC, 0x23); /* 35 * 171 us */
+	err |= aw_wr(AW_DRV_LVL, (uint8_t)level);
+	err |= aw_wr(AW_DRV_LVL_OV, AW_V_DRV_LVL_OV);
+	err |= aw_bits(AW_GO, 0x01, 0x01);
+	return err;
+}
+
+/* aw8624_haptic_get_f0: one open-loop trace, f0 in 0.1 Hz. */
+static int
+aw_get_f0(unsigned *f0)
+{
+	int err = aw_stop();
+	err |= aw_cont_mode();
+	err |= aw_bits(AW_CONT_CTRL, 0x08, 0x00); /* open playback */
+	err |= aw_bits(AW_CONT_CTRL, 0x04, 0x04); /* f0 detect */
+	err |= aw_bits(AW_DATCTRL, 0xe0, 0xe0);
+	err |= aw_bits(AW_ANACTRL, 0x20, 0x20);   /* LRA clock from TRIM_LRA (CALI_F0) */
+	err |= aw_f0_preset();
+	err |= aw_wr(AW_DRV_LVL, AW_V_DRV_LVL);
+	err |= aw_wr(AW_NUM_F0_1, (uint8_t)((aw_trace[0] << 4) | aw_trace[1]));
+	err |= aw_wr(AW_NUM_F0_2, aw_trace[2]);
+	err |= aw_wr(AW_NUM_F0_3, aw_trace[3]);
+	uint8_t v = 0, h = 0, l = 0, mp = 0, mn = 0;
+	err |= aw_rd(AW_SYSINT, &v);
+	err |= aw_bits(AW_GO, 0x01, 0x01);
+	if (err) {
+		return err;
+	}
+	unsigned t_f0_ms = 1000u * 10u / AW_V_F0_PRE;
+	touch_wait(t_f0_ms * (aw_trace[0] + aw_trace[1] +
+	    (aw_trace[3] + aw_trace[1]) * aw_trace[2]) + 10u);
+	err = ETIMEDOUT;
+	for (unsigned i = 0; i < 50; ++i) {
+		if (aw_rd(AW_GLB_STATE, &v)) {
+			err = EIO;
+			break;
+		}
+		if ((v & 0x0f) == 0) {
+			err = aw_rd(AW_F_LRA_F0_H, &h);
+			err |= aw_rd(AW_F_LRA_F0_L, &l);
+			(void)aw_rd(AW_WAIT_VOL_MP, &mp);
+			(void)aw_rd(AW_WAIT_VOL_MN, &mn);
+			unsigned reg = ((unsigned)h << 8) | l;
+			/* Xiaomi keeps the preset when the chip reports 0. */
+			*f0 = reg ? 1000000000u / (reg * AW_V_F0_COEFF) : AW_V_F0_PRE;
+			printf("SURYA VIB: f0 reg %#x -> %u.%u Hz, bemf max +%u -%u\n",
+			    reg, *f0 / 10u, *f0 % 10u, mp, mn);
+			break;
+		}
+		touch_wait(10);
+	}
+	(void)aw_bits(AW_CONT_CTRL, 0x08, 0x08); /* closed playback */
+	(void)aw_bits(AW_CONT_CTRL, 0x04, 0x00); /* f0 detect off */
+	return err;
+}
+
+/* aw8624_haptic_f0_calibration: TRIM_LRA from the measured f0. */
+static void
+aw_f0_calibrate(void)
+{
+	svib.trim = 0;
+	(void)aw_wr(AW_TRIM_LRA, 0);
+	unsigned f0 = AW_V_F0_PRE;
+	int err = aw_get_f0(&f0);
+	if (err) {
+		printf("SURYA VIB: f0 measurement failed %d, trim 0\n", err);
+	} else {
+		int pre = (int)AW_V_F0_PRE, lim = (int)f0;
+		if (f0 * 100u < AW_V_F0_PRE * (100u - AW_V_CALI_PCT) ||
+		    f0 * 100u > AW_V_F0_PRE * (100u + AW_V_CALI_PCT)) {
+			lim = pre;
+		}
+		int base = svib.chipid_flag == 1 ? 32 : 16;
+		int step = 100000 * (lim - pre) / (lim * 25);
+		if (step >= 0) {
+			step = base + step / 10 + (step % 10 >= 5 ? 1 : 0);
+		} else {
+			step = base + step / 10 - (step % 10 <= -5 ? 1 : 0);
+		}
+		int lra;
+		if (svib.chipid_flag == 1) {
+			lra = step > 31 ? step - 32 : step + 32;
+		} else {
+			lra = (step < 16 || (step > 31 && step < 48)) ? step + 16 : step - 16;
+		}
+		svib.trim = (uint8_t)lra;
+		uint8_t back = 0xee;
+		(void)aw_wr(AW_TRIM_LRA, svib.trim);
+		(void)aw_rd(AW_TRIM_LRA, &back);
+		printf("SURYA VIB: f0 %u.%u Hz (limit %d), step %d, trim %#x read back %#x\n",
+		    f0 / 10u, f0 % 10u, lim, step, svib.trim, back);
+	}
+	(void)aw_standby();
+	(void)aw_stop();
+}
+
+static bool
+surya_vib_se_init(void)
+{
+	vm_offset_t se = svib.se;
+	uint32_t fw = touch_rd(se, SE_FW);
+	uint32_t tx = touch_rd(se, SE_HW_TX), rx = touch_rd(se, SE_HW_RX);
+	printf("SURYA VIB: se1 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(se, SE_STATUS), tx, rx);
+	/* Protocol 3 = I2C (qcom-geni-se.h); SE firmware comes from qupfw. */
+	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SURYA VIB: need I2C firmware on SE1 and 32-bit FIFOs; stopping\n");
+		return false;
+	}
+	if (touch_rd(se, SE_STATUS) & 0x1001u) {
+		printf("SURYA VIB: SE1 already busy; stopping\n");
+		return false;
+	}
+	touch_wr(se, 0xe18, 0); /* no GSI events */
+	touch_wr(se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(se, 0x644, 0);
+	touch_wr(se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(se, 0x648, 0xffffffffu);
+	touch_wr(se, SE_DMA, 0);
+	touch_wr(se, 0x28, touch_rd(se, 0x28) | 0x7fu);
+	touch_wr(se, 0xe30, touch_rd(se, 0xe30) | 0x0fu);
+	touch_wr(se, 0x24, 0x7f);
+	touch_wr(se, 0x20, 1);
+	touch_wr(se, SE_CLK_SEL, 0);
+	/* i2c-qcom-geni.c geni_i2c_clk_map, 400 kHz: divider 2, t_high 5, t_low 12, cycle 24. */
+	touch_wr(se, SE_MCLK, (2u << 4) | 1u);
+	touch_wr(se, SE_SCL, (5u << 20) | (12u << 10) | 24u);
+	/* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
+	touch_wr(se, 0x254, 0);
+	touch_wr(se, 0x260, SE_PACK0);
+	touch_wr(se, 0x264, SE_PACK1);
+	touch_wr(se, 0x284, SE_PACK0);
+	touch_wr(se, 0x288, SE_PACK1);
+	touch_wr(se, SE_TX_WM, 0);
+	touch_wr(se, 0x810, 0);
+	touch_wr(se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(se, SE_IRQ_EN, SE_EVENTS);
+	if (touch_rd(se, 0x260) != SE_PACK0 || touch_rd(se, 0x264) != SE_PACK1 ||
+	    touch_rd(se, 0x284) != SE_PACK0 || touch_rd(se, 0x288) != SE_PACK1 ||
+	    touch_rd(se, 0x254) != 0) {
+		printf("SURYA VIB: packing readback mismatch; stopping\n");
+		return false;
+	}
+	if ((touch_rd(se, SE_TX_COUNT) & 0xfffffffu) || (touch_rd(se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SURYA VIB: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+/* Bus, reset, chip id 0x24, then aw8624_haptic_init with its f0 calibration. */
+static bool
+surya_vib_init(void)
+{
+	svib.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	svib.north = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	svib.south = ml_io_map(SURYA_SOUTH_PA, 0x1b000);
+	svib.se = ml_io_map(SURYA_VIB_SE_PA, 0x4000);
+	if (!svib.gcc || !svib.north || !svib.south || !svib.se) {
+		printf("SURYA VIB: MMIO mapping failed\n");
+		return false;
+	}
+	printf("SURYA VIB: before: sda cfg=%#x scl cfg=%#x rst cfg=%#x io=%#x irq cfg=%#x io=%#x\n",
+	    touch_rd(svib.south, TOUCH_GPIO_CFG(0)), touch_rd(svib.south, TOUCH_GPIO_CFG(1)),
+	    touch_rd(svib.north, TOUCH_GPIO_CFG(SURYA_VIB_RST_GPIO)),
+	    touch_rd(svib.north, TOUCH_GPIO_IO(SURYA_VIB_RST_GPIO)),
+	    touch_rd(svib.south, TOUCH_GPIO_CFG(SURYA_VIB_IRQ_GPIO)),
+	    touch_rd(svib.south, TOUCH_GPIO_IO(SURYA_VIB_IRQ_GPIO)));
+	if (!surya_qup_clocks(svib.gcc, SURYA_VIB_VOTE, SURYA_VIB_RCG, 0x17160, "VIB") ||
+	    !surya_vib_se_init()) {
+		return false;
+	}
+	surya_pin(svib.south, 0, 1, 0, 0, false, false); /* qup01 SDA, no pull, 2 mA */
+	surya_pin(svib.south, 1, 1, 0, 0, false, false); /* qup01 SCL */
+	surya_pin(svib.south, SURYA_VIB_IRQ_GPIO, 0, 3, 0, false, false); /* input, pull-up */
+	uint8_t id = 0;
+	int err = EIO;
+	for (unsigned retry = 0; retry < 3 && !svib.dead; ++retry) {
+		/* aw8624_hw_reset: low 5 ms, high 5 ms (msm_gpio_63: gpio, 2 mA, no pull) */
+		surya_pin(svib.north, SURYA_VIB_RST_GPIO, 0, 0, 0, true, false);
+		touch_wait(5);
+		surya_pin(svib.north, SURYA_VIB_RST_GPIO, 0, 0, 0, true, true);
+		touch_wait(5);
+		err = aw_rd(AW_ID, &id);
+		printf("SURYA VIB: chip id try %u err=%d id=%#x\n", retry, err, id);
+		if (!err && id == 0x24) {
+			break;
+		}
+		touch_wait(10);
+	}
+	if (err || id != 0x24) {
+		printf("SURYA VIB: no AW8624; stopping\n");
+		return false;
+	}
+	(void)aw_wr(AW_ID, 0xaa); /* soft reset */
+	touch_wait(2);
+	uint8_t ef = 0;
+	svib.chipid_flag = !aw_rd(AW_EF_RDATAH, &ef) && (ef & 1u);
+	err = aw_standby();
+	err |= aw_bits(AW_PWMDBG, 0x60, 0x40);  /* PWM 24 kHz */
+	err |= aw_bits(AW_DETCTRL, 0x20, 0x20); /* motor protection: no action */
+	err |= aw_bits(AW_PWMPRC, 0x80, 0x00);
+	err |= aw_bits(AW_PRLVL, 0x80, 0x00);
+	err |= aw_bits(AW_ADCTEST, 0x40, 0x40); /* CONT battery compensation in hardware */
+	err |= aw_bits(AW_R_SPARE, 0x80, 0x80);
+	if (err) {
+		printf("SURYA VIB: init writes failed %d; stopping\n", err);
+		return false;
+	}
+	aw_f0_calibrate();
+	err = aw_wr(AW_SW_BRAKE, AW_V_SW_BRAKE);
+	err |= aw_wr(AW_THRS_BRA_END, 0x00);
+	err |= aw_bits(AW_WAVECTRL, 0xf0, 0x00);
+	err |= aw_wr(AW_ZC_THRSH_H, (uint8_t)(AW_V_ZC_THR >> 8));
+	err |= aw_wr(AW_ZC_THRSH_L, (uint8_t)AW_V_ZC_THR);
+	err |= aw_wr(AW_TSET, AW_V_TSET);
+	for (unsigned i = 0; i < 4; ++i) {
+		err |= aw_wr((uint8_t)(AW_BEMF_VTHH_H + i), aw_bemf[i]);
+	}
+	printf("SURYA VIB: AW8624 ready (efuse flag %d, trim %#x, retries %u)%s\n",
+	    svib.chipid_flag, svib.trim, svib.retries, err ? " with write errors" : "");
+	return !svib.dead;
+}
+
+/* Intensity (16.16, 1.0 = 0x10000) to the CONT drive level; 0 stops. */
+static void
+surya_vib_drive(uint32_t intensity)
+{
+	unsigned level = 0;
+	if (intensity) {
+		uint64_t l = ((uint64_t)AW_V_DRV_LVL * (intensity > 0x10000u ? 0x10000u : intensity) +
+		    0x8000u) >> 16;
+		level = l ? (unsigned)l : 1u;
+	}
+	if ((int)level == svib.level) {
+		return;
+	}
+	int err;
+	if (!level) {
+		err = aw_stop();
+	} else if (svib.level > 0) {
+		err = aw_wr(AW_DRV_LVL, (uint8_t)level); /* already playing: new level only */
+	} else {
+		err = aw_cont_start(level);
+	}
+	if (svib.changes < 200) {
+		++svib.changes;
+		printf("SURYA VIB: level %d -> %u%s\n", svib.level, level, err ? " FAILED" : "");
+	}
+	svib.level = err ? -1 : (int)level;
+}
+
+/* Sleep up to ms, or less if a new pattern arrives (thread_wakeup on svib_chan). */
+static void
+surya_vib_wait(unsigned ms, unsigned gen)
+{
+	if (ms) {
+		uint64_t deadline;
+		clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&svib_chan, THREAD_UNINT, deadline);
+	} else {
+		(void)assert_wait(&svib_chan, THREAD_UNINT);
+	}
+	IOLockLock(svib.lock);
+	bool fresh = svib.gen != gen;
+	IOLockUnlock(svib.lock);
+	if (fresh) {
+		(void)clear_wait(current_thread(), THREAD_AWAKENED);
+	} else {
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+surya_vib_loop(void)
+{
+	uint32_t seg[2 * SURYA_VIB_MAX_SEG];
+	unsigned n = 0, i = 0, gen = 0;
+	bool repeat = false, sampled = false;
+	int pid = 0;
+	uint64_t started = 0;
+	for (;;) {
+		IOLockLock(svib.lock);
+		if (svib.gen != gen) {
+			gen = svib.gen;
+			n = svib.nseg;
+			repeat = svib.repeat;
+			pid = svib.pid;
+			bcopy(svib.seg, seg, sizeof(seg[0]) * 2u * n);
+			i = 0;
+			started = surya_now_ns();
+			sampled = false;
+		}
+		IOLockUnlock(svib.lock);
+		if (i < n && surya_now_ns() - started > SURYA_VIB_CAP_NS) {
+			printf("SURYA VIB: pattern still running after 120 s; stopped\n");
+			n = 0;
+		}
+		/* 22.10: a 1 s ConnectedToPower vibration repeated until the 120 s cap,
+		 * iOS never sent the stop. Where are the sender's threads 3 s in? */
+		if (i < n && repeat && !sampled && svib.samples < 3 &&
+		    surya_now_ns() - started > 3000000000ULL) {
+			sampled = true;
+			++svib.samples;
+			proc_t p = proc_find(pid);
+			if (p != NULL) {
+				char name[32];
+				proc_name(pid, name, sizeof(name));
+				printf("SURYA VIB: repeating pattern from %s[%d] 3 s without a stop; its threads:\n",
+				    name, pid);
+				task_t task = proc_task(p);
+				if (task != TASK_NULL) {
+					sweet_sample_task(name, pid, task);
+				}
+				proc_rele(p);
+			}
+		}
+		if (i >= n) {
+			surya_vib_drive(0);
+			surya_vib_wait(0, gen); /* until the next pattern */
+			continue;
+		}
+		surya_vib_drive(seg[2u * i]);
+		unsigned ms = seg[2u * i + 1u];
+		if (++i >= n && repeat) {
+			i = 0;
+		}
+		surya_vib_wait(ms, gen);
+	}
+}
+
+/*
+ * From SweetBattery's "vibrator" service: n pairs of intensity (16.16, 0 =
+ * off) and milliseconds replace whatever plays; n = 0 stops. Never blocks.
+ * Returns -1 when there is no usable chip.
+ */
+int surya_vib_play(const uint32_t *pairs, unsigned n, int repeat);
+
+int
+surya_vib_play(const uint32_t *pairs, unsigned n, int repeat)
+{
+	if (!svib.lock || svib.dead) {
+		return -1;
+	}
+	if (n > SURYA_VIB_MAX_SEG) {
+		printf("SURYA VIB: pattern of %u pairs cut to %u\n", n, SURYA_VIB_MAX_SEG);
+		n = SURYA_VIB_MAX_SEG;
+	}
+	IOLockLock(svib.lock);
+	for (unsigned i = 0; i < n; ++i) {
+		svib.seg[2u * i] = pairs[2u * i];
+		svib.seg[2u * i + 1u] = pairs[2u * i + 1u] ? pairs[2u * i + 1u] : 1u;
+	}
+	svib.nseg = n;
+	svib.repeat = repeat && n;
+	svib.pid = proc_selfpid();
+	++svib.gen;
+	IOLockUnlock(svib.lock);
+	thread_wakeup(&svib_chan);
+	return 0;
+}
+
+static void
+surya_vib_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	/* sweet_touch_init runs right before sweet_usb_probe: let the USB log come
+	 * up first, so a bus problem here is seen. Still well before mediaserverd;
+	 * a pattern sent earlier waits for the chip. */
+	touch_wait(3000);
+	if (surya_vib_init()) {
+		surya_vib_loop();
+	}
+	svib.dead = true;
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Power off and restart: ask the player to stop and give it 300 ms. */
+static void
+surya_vib_off(void)
+{
+	if (svib.dead || svib.level == 0 || surya_vib_play(NULL, 0, 0)) {
+		return;
+	}
+	for (unsigned i = 0; i < 300 && svib.level != 0; ++i) {
+		delay(1000);
+	}
+}
+
+static void
+surya_lights_off(void)
+{
+	if (surya_torch_on) {
+		(void)surya_torch_set(0);
+	}
+	if (surya_led_duty) {
+		(void)surya_led_set(0);
+	}
+	if (surya_led_testing) {
+		(void)surya_led_chan(surya_led_testing - 1u, 0);
+		surya_led_testing = 0;
+	}
+}
+
+/*
+ * Measurements, boot-arg suryastat=1 (notes/wishes/04, step 3): read-only,
+ * nothing is configured. Once, 60 s after start:
+ *  - OSM (qcom,clk-cpu-osm-sdmmagpie, Xiaomi clk-cpu-osm.c): L3, the small
+ *    and the big cluster: enable bit, the frequency table (+0x110 + 32 i:
+ *    bits 31:30 source, 7:0 multiplier of 19.2 MHz, source 0 = 300 MHz),
+ *    the requested row per core (+0x920 + 4 n) and the cycle counters
+ *    (+0x9c0 + 4 n) over one second;
+ *  - every CPU's PMU cycle counter against the 19.2 MHz counter for 20 ms;
+ *  - copy speed: cache to cache, panel to cache, cache to panel;
+ *  - MDSS (Xiaomi DT qcom,sde-*-off): the five SSPP channels, six CTLs and
+ *    four interfaces, and the DSI interfaces' frame counters over 1 s;
+ *  - the kernel's own timers: one thread_call on the absolute and one on the
+ *    continuous clock, 1 s each (the vibration stop timer never fired).
+ * Then every 10 s: swaps, repeated swaps, panel copies (mean and max time),
+ * vsync ticks, each CPU's idle share, panel frames, TSENS temperatures.
+ */
+#define STAT_OSM_L3_PA    0x18321000u
+#define STAT_OSM_PWR_PA   0x18323000u
+#define STAT_OSM_PERF_PA  0x18325800u
+#define STAT_MDSS_PA      0x0ae00000u
+#define STAT_TSENS0_PA    0x0c263000u /* TM blocks (second reg of tsens@c222000/c223000) */
+#define STAT_TSENS1_PA    0x0c265000u
+#define STAT_COPY_BYTES   (4u << 20)
+
+extern unsigned surya_cpu_idle_mask(void);                 /* osfmk/kern/exception.c */
+extern int surya_cpu_measure(unsigned cpu, unsigned ms, uint64_t *cycles, uint64_t *ticks, uint64_t *base);
+extern uint64_t surya_rtclock_base(void);
+extern int sweet_fb_stat_on;                               /* iokit/Kernel/arm/SweetFramebuffer.cpp */
+extern uint64_t sweet_fb_stat_swaps, sweet_fb_stat_dups, sweet_fb_stat_copies;
+extern uint64_t sweet_fb_stat_copy_ns, sweet_fb_stat_copy_max_ns, sweet_fb_stat_ticks;
+extern uintptr_t sweet_fb_stat_pixels;
+extern uint32_t sweet_fb_stat_rowbytes, sweet_fb_stat_width, sweet_fb_stat_height;
+extern uint64_t sweet_fb_stat_iv[4], sweet_fb_stat_wait_ns, sweet_fb_stat_waits, sweet_fb_stat_flips;
+extern uint64_t sweet_fb_stat_flip_late;
+extern unsigned int processor_count;
+
+static struct {
+	vm_offset_t l3, pwr, perf, mdss, tsens[2];
+	volatile int fired[2];
+	uint64_t fired_at[2];
+} sst;
+
+static void
+stat_osm(const char *name, vm_offset_t base, unsigned cores)
+{
+	if (!base) {
+		return;
+	}
+	printf("SURYA STAT: OSM %s enable %#x dcvs_ctrl %#x\n", name,
+	    touch_rd(base, 0), touch_rd(base, 0xbc));
+	char line[200];
+	int n = 0;
+	unsigned rows = 0;
+	for (unsigned i = 0; i < 40; ++i) {
+		uint32_t v = touch_rd(base, 0x110u + 32u * i);
+		unsigned mhz = ((v >> 30) & 3u) ? (v & 0xffu) * 192u / 10u : 300u;
+		if (i && v == touch_rd(base, 0x110u + 32u * (i - 1u))) {
+			break; /* the table ends where it repeats (clk_osm_resources_init) */
+		}
+		rows = i + 1;
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %u:%u", i, mhz);
+		if (i % 10 == 9 || i == 39) {
+			printf("SURYA STAT: OSM %s rows%s\n", name, line);
+			n = 0;
+		}
+	}
+	if (n) {
+		printf("SURYA STAT: OSM %s rows%s\n", name, line);
+	}
+	n = 0;
+	for (unsigned c = 0; c < cores; ++c) {
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " c%u:%u", c,
+		    touch_rd(base, 0x920u + 4u * c));
+	}
+	printf("SURYA STAT: OSM %s %u rows, requested row%s\n", name, rows, line);
+	uint32_t c0[8], c1[8];
+	for (unsigned c = 0; c < cores && c < 8; ++c) {
+		c0[c] = touch_rd(base, 0x9c0u + 4u * c);
+	}
+	uint64_t t0 = surya_now_ns();
+	touch_wait(1000);
+	uint64_t dt = surya_now_ns() - t0;
+	n = 0;
+	for (unsigned c = 0; c < cores && c < 8; ++c) {
+		c1[c] = touch_rd(base, 0x9c0u + 4u * c);
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " c%u:%llu", c,
+		    (unsigned long long)((uint64_t)(c1[c] - c0[c]) * 1000ULL / (dt / 1000000ULL)));
+	}
+	printf("SURYA STAT: OSM %s cycle counters per second%s\n", name, line);
+}
+
+static void
+stat_cpus(void)
+{
+	/* Also the clocks (22.10: iOS's 1 s vibration stop timer never fired):
+	 * userland builds mach_absolute_time as CNTVCT_EL0 + the commpage's
+	 * rtclock_base_abstime; the kernel adds each CPU's own base. */
+	uint64_t rtb = surya_rtclock_base();
+	printf("SURYA STAT: timebase base (this CPU) %#llx, mach_absolute_time %#llx, CNTVCT %#llx, continuous %#llx\n",
+	    (unsigned long long)rtb, (unsigned long long)mach_absolute_time(),
+	    (unsigned long long)__builtin_arm_rsr64("CNTVCT_EL0"), (unsigned long long)mach_continuous_time());
+	for (unsigned cpu = 0; cpu < processor_count && cpu < 8; ++cpu) {
+		uint64_t cycles = 0, ticks = 0, base = 0;
+		int err = surya_cpu_measure(cpu, 20, &cycles, &ticks, &base);
+		if (err) {
+			printf("SURYA STAT: cpu%u measure failed %d\n", cpu, err);
+		} else {
+			/* 19.2 MHz counter: MHz = cycles * 19.2 / ticks */
+			printf("SURYA STAT: cpu%u %llu cycles in %llu ticks -> %llu MHz; timebase base %#llx%s\n", cpu,
+			    (unsigned long long)cycles, (unsigned long long)ticks,
+			    (unsigned long long)(ticks ? cycles * 192ULL / 10ULL / ticks : 0),
+			    (unsigned long long)base, base == rtb ? "" : " DIFFERS from the first CPU's");
+		}
+	}
+}
+
+static uint64_t
+stat_copy(void *dst, const void *src, size_t len, unsigned times)
+{
+	uint64_t t0 = surya_now_ns();
+	for (unsigned i = 0; i < times; ++i) {
+		memcpy(dst, src, len);
+	}
+	uint64_t ns = surya_now_ns() - t0;
+	return ns ? (uint64_t)len * times * 1000ULL / ns : 0; /* MB/s */
+}
+
+static void
+stat_copies(void)
+{
+	uint8_t *a = kalloc_data(STAT_COPY_BYTES, Z_WAITOK);
+	uint8_t *b = kalloc_data(STAT_COPY_BYTES, Z_WAITOK);
+	if (!a || !b) {
+		printf("SURYA STAT: no memory for the copy test\n");
+	} else {
+		memset(a, 0x5a, STAT_COPY_BYTES);
+		uint64_t cc = stat_copy(b, a, STAT_COPY_BYTES, 4);
+		uint64_t pc = 0, cp = 0;
+		if (sweet_fb_stat_pixels && sweet_fb_stat_rowbytes) {
+			/* the panel's own top rows, read back then written back: nothing changes */
+			size_t rows = STAT_COPY_BYTES / sweet_fb_stat_rowbytes;
+			if (rows > sweet_fb_stat_height) {
+				rows = sweet_fb_stat_height;
+			}
+			size_t len = rows * sweet_fb_stat_rowbytes;
+			pc = stat_copy(a, (const void *)sweet_fb_stat_pixels, len, 1);
+			cp = stat_copy((void *)sweet_fb_stat_pixels, a, len, 4);
+		}
+		printf("SURYA STAT: copy MB/s: cache->cache %llu, panel->cache %llu, cache->panel %llu\n",
+		    (unsigned long long)cc, (unsigned long long)pc, (unsigned long long)cp);
+	}
+	if (a) {
+		kfree_data(a, STAT_COPY_BYTES);
+	}
+	if (b) {
+		kfree_data(b, STAT_COPY_BYTES);
+	}
+}
+
+static void
+stat_mdss(void)
+{
+	static const uint32_t sspp[5] = {0x5000, 0x7000, 0x25000, 0x27000, 0x29000};
+	static const char *const sspp_name[5] = {"vig0", "vig1", "dma0", "dma1", "dma2"};
+	if (!sst.mdss) {
+		return;
+	}
+	for (unsigned i = 0; i < 5; ++i) {
+		vm_offset_t b = sst.mdss + sspp[i];
+		printf("SURYA STAT: sspp %s src_size %#x src_xy %#x out_size %#x out_xy %#x addr %#x stride %#x "
+		    "format %#x op_mode %#x\n", sspp_name[i], touch_rd(b, 0x00), touch_rd(b, 0x08),
+		    touch_rd(b, 0x0c), touch_rd(b, 0x10), touch_rd(b, 0x14), touch_rd(b, 0x24),
+		    touch_rd(b, 0x30), touch_rd(b, 0x38));
+	}
+	for (unsigned i = 0; i < 6; ++i) {
+		vm_offset_t b = sst.mdss + 0x2000u + 0x200u * i;
+		printf("SURYA STAT: ctl%u layer %#x %#x %#x %#x top %#x flush %#x intf_active %#x fetch_active %#x\n",
+		    i, touch_rd(b, 0x00), touch_rd(b, 0x04), touch_rd(b, 0x08), touch_rd(b, 0x0c),
+		    touch_rd(b, 0x14), touch_rd(b, 0x18), touch_rd(b, 0xf4), touch_rd(b, 0xfc));
+	}
+	uint32_t f0[4], f1[4];
+	for (unsigned i = 0; i < 4; ++i) {
+		vm_offset_t b = sst.mdss + 0x6b000u + 0x800u * i;
+		f0[i] = touch_rd(b, 0xac);
+		printf("SURYA STAT: intf%u timing_en %#x config %#x frame_count %u line_count %u\n", i,
+		    touch_rd(b, 0x00), touch_rd(b, 0x04), f0[i], touch_rd(b, 0xb0));
+	}
+	uint64_t t0 = surya_now_ns();
+	touch_wait(1000);
+	uint64_t dt = surya_now_ns() - t0;
+	for (unsigned i = 0; i < 4; ++i) {
+		f1[i] = touch_rd(sst.mdss + 0x6b000u + 0x800u * i, 0xac);
+		if (f1[i] != f0[i]) {
+			printf("SURYA STAT: intf%u %u frames in %llu ms -> %llu.%llu Hz\n", i, f1[i] - f0[i],
+			    (unsigned long long)(dt / 1000000ULL),
+			    (unsigned long long)((uint64_t)(f1[i] - f0[i]) * 1000000000ULL / dt),
+			    (unsigned long long)((uint64_t)(f1[i] - f0[i]) * 10000000000ULL / dt % 10ULL));
+		}
+	}
+}
+
+static void
+stat_tsens(void)
+{
+	for (unsigned t = 0; t < 2; ++t) {
+		char line[200];
+		int n = 0;
+		if (!sst.tsens[t]) {
+			continue;
+		}
+		for (unsigned s = 0; s < 16; ++s) {
+			uint32_t v = touch_rd(sst.tsens[t], 0xa0u + 4u * s);
+			if (!(v & (1u << 21))) {
+				continue; /* VALID */
+			}
+			int temp = (int)(v & 0xfffu);
+			if (temp & 0x800) {
+				temp -= 0x1000; /* 12-bit signed, 0.1 C */
+			}
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %u:%d.%d", s, temp / 10,
+			    (temp < 0 ? -temp : temp) % 10);
+		}
+		printf("SURYA STAT: tsens%u C%s\n", t, line);
+	}
+}
+
+static void
+stat_timer_fired(thread_call_param_t p0, thread_call_param_t p1)
+{
+	unsigned which = (unsigned)(uintptr_t)p0;
+	(void)p1;
+	sst.fired_at[which] = surya_now_ns();
+	sst.fired[which] = 1;
+}
+
+static void
+stat_timers(void)
+{
+	thread_call_t calls[2];
+	uint64_t one_s;
+	nanoseconds_to_absolutetime(1000000000ULL, &one_s);
+	uint64_t start = surya_now_ns();
+	for (unsigned i = 0; i < 2; ++i) {
+		calls[i] = thread_call_allocate_with_options(stat_timer_fired, (thread_call_param_t)(uintptr_t)i,
+		    THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE);
+		if (!calls[i]) {
+			printf("SURYA STAT: no thread_call\n");
+			return;
+		}
+	}
+	(void)thread_call_enter_delayed_with_leeway(calls[0], NULL, mach_absolute_time() + one_s, 0, 0);
+	(void)thread_call_enter_delayed_with_leeway(calls[1], NULL, mach_continuous_time() + one_s, 0,
+	    THREAD_CALL_CONTINUOUS);
+	touch_wait(3000);
+	for (unsigned i = 0; i < 2; ++i) {
+		printf("SURYA STAT: 1 s thread_call on the %s clock %s%llu ms\n",
+		    i ? "continuous" : "absolute", sst.fired[i] ? "fired after " : "NOT fired in ",
+		    (unsigned long long)((sst.fired[i] ? sst.fired_at[i] - start : surya_now_ns() - start) / 1000000ULL));
+		(void)thread_call_cancel(calls[i]);
+		(void)thread_call_free(calls[i]);
+	}
+	printf("SURYA STAT: clocks: absolute %#llx continuous %#llx\n",
+	    (unsigned long long)mach_absolute_time(), (unsigned long long)mach_continuous_time());
+}
+
+static void
+surya_stat_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	touch_wait(60000);
+	sst.l3 = ml_io_map(STAT_OSM_L3_PA, 0x1400);
+	sst.pwr = ml_io_map(STAT_OSM_PWR_PA, 0x1400);
+	sst.perf = ml_io_map(STAT_OSM_PERF_PA, 0x1400);
+	sst.mdss = ml_io_map(STAT_MDSS_PA, 0x85000);
+	sst.tsens[0] = ml_io_map(STAT_TSENS0_PA, 0x1000);
+	sst.tsens[1] = ml_io_map(STAT_TSENS1_PA, 0x1000);
+	printf("SURYA STAT: start, %u processors, panel %ux%u stride %u\n", processor_count,
+	    sweet_fb_stat_width, sweet_fb_stat_height, sweet_fb_stat_rowbytes);
+	stat_osm("L3", sst.l3, 1);
+	stat_osm("small", sst.pwr, 6);
+	stat_osm("big", sst.perf, 2);
+	stat_cpus();
+	stat_copies();
+	stat_mdss();
+	stat_timers();
+	uint64_t swaps = sweet_fb_stat_swaps, dups = sweet_fb_stat_dups, copies = sweet_fb_stat_copies;
+	uint64_t cns = sweet_fb_stat_copy_ns, ticks = sweet_fb_stat_ticks;
+	uint32_t frames = sst.mdss ? touch_rd(sst.mdss + 0x6b800u, 0xac) : 0;
+	uint64_t iv0[4], wns0 = sweet_fb_stat_wait_ns, wn0 = sweet_fb_stat_waits;
+	uint64_t fl0 = sweet_fb_stat_flips, fll0 = sweet_fb_stat_flip_late;
+	memcpy(iv0, sweet_fb_stat_iv, sizeof(iv0));
+	for (;;) {
+		unsigned idle[8] = {0}, samples = 0;
+		sweet_fb_stat_copy_max_ns = 0;
+		for (unsigned i = 0; i < 2000; ++i) {
+			unsigned mask = surya_cpu_idle_mask();
+			for (unsigned c = 0; c < 8; ++c) {
+				idle[c] += (mask >> c) & 1u;
+			}
+			++samples;
+			touch_wait(5);
+		}
+		uint64_t s = sweet_fb_stat_swaps, d = sweet_fb_stat_dups, c = sweet_fb_stat_copies;
+		uint64_t n = sweet_fb_stat_copy_ns, t = sweet_fb_stat_ticks;
+		uint32_t f = sst.mdss ? touch_rd(sst.mdss + 0x6b800u, 0xac) : 0;
+		printf("SURYA STAT: 10 s: swaps %llu (same as previous %llu), panel copies %llu "
+		    "mean %llu ms max %llu ms, vsync ticks %llu, panel frames %u, idle %% %u %u %u %u %u %u %u %u\n",
+		    (unsigned long long)(s - swaps), (unsigned long long)(d - dups), (unsigned long long)(c - copies),
+		    (unsigned long long)(c > copies ? (n - cns) / (c - copies) / 1000000ULL : 0),
+		    (unsigned long long)(sweet_fb_stat_copy_max_ns / 1000000ULL), (unsigned long long)(t - ticks),
+		    f - frames, idle[0] * 100u / samples, idle[1] * 100u / samples, idle[2] * 100u / samples,
+		    idle[3] * 100u / samples, idle[4] * 100u / samples, idle[5] * 100u / samples,
+		    idle[6] * 100u / samples, idle[7] * 100u / samples);
+		{
+			/* 23.10: the frame rhythm. Swap-to-swap intervals (a 60 Hz frame
+			 * is 16.7 ms, one missed vsync 33 ms), the time CoreAnimation spends
+			 * in SwapWait, page flips (suryafb=4) and flips that had to wait
+			 * for the previous one to latch. */
+			uint64_t iv[4], wns = sweet_fb_stat_wait_ns, wn = sweet_fb_stat_waits;
+			uint64_t fl = sweet_fb_stat_flips, fll = sweet_fb_stat_flip_late;
+			memcpy(iv, sweet_fb_stat_iv, sizeof(iv));
+			printf("SURYA STAT: 10 s frames: swap intervals <20 ms %llu, 20-37 %llu, 37-55 %llu, >55 %llu; "
+			    "SwapWait %llu calls mean %llu us; flips %llu (waited for latch %llu)\n",
+			    (unsigned long long)(iv[0] - iv0[0]), (unsigned long long)(iv[1] - iv0[1]),
+			    (unsigned long long)(iv[2] - iv0[2]), (unsigned long long)(iv[3] - iv0[3]),
+			    (unsigned long long)(wn - wn0),
+			    (unsigned long long)(wn > wn0 ? (wns - wns0) / (wn - wn0) / 1000ULL : 0),
+			    (unsigned long long)(fl - fl0), (unsigned long long)(fll - fll0));
+			memcpy(iv0, iv, sizeof(iv0));
+			wns0 = wns;
+			wn0 = wn;
+			fl0 = fl;
+			fll0 = fll;
+		}
+		stat_tsens();
+		swaps = s;
+		dups = d;
+		copies = c;
+		cns = n;
+		ticks = t;
+		frames = f;
+	}
+}
+
+/*
+ * suryafb2x=1 (SweetFramebuffer.cpp): MobileGestalt caches the screen class
+ * (display-scale) in a plist; with the ADT now saying 2 the caches are
+ * truncated as soon as the root is mounted, before MobileGestaltHelper
+ * starts (22.10: truncating only when the first copy was requested came
+ * after it, backboardd still rendered 1125x2436 and never swapped).
+ */
+static const char *const surya_mg_caches[2] = {
+	"/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist",
+	"/private/var/mobile/Library/Caches/com.apple.MobileGestalt.plist",
+};
+
+static void
+surya_fb2x_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	while (!surya_root_ready()) {
+		touch_wait(20);
+	}
+	for (unsigned i = 0; i < 2; ++i) {
+		uint8_t probe = 0;
+		int err = surya_db_rw(surya_mg_caches[i], 0, &probe, 1);
+		if (err == ENOENT) {
+			printf("SURYA FB2X: no cache %u\n", i);
+			continue;
+		}
+		err = surya_db_rw(surya_mg_caches[i], 1, &probe, 0);
+		printf("SURYA FB2X: cache %u truncated, err %d\n", i, err);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+int surya_fb2x_reset_cache(void);
+
+/* Kept for SweetFramebuffer.cpp: the work is done by the thread above. */
+int
+surya_fb2x_reset_cache(void)
+{
+	return 0;
+}
+
+/*
+ * The panel's current scan line (MDSS INTF1 LINE_COUNT, dpu_hw_intf.c 0xb0;
+ * surya's DSI interface is intf1 at 0xae6b800, suryastat 22.10). Read by
+ * SweetFramebuffer.cpp's copy thread to start a copy right behind the top of
+ * a frame, so the copy (5 ms) stays ahead of the scan (16.7 ms): no tearing
+ * seam (23.10: a seam at the top with copies started at the swap). -1 when
+ * MDSS cannot be mapped.
+ */
+static vm_offset_t surya_mdss_map;
+
+int surya_panel_line(void);
+
+int
+surya_panel_line(void)
+{
+	if (!surya_mdss_map) {
+		surya_mdss_map = ml_io_map(STAT_MDSS_PA, 0x85000);
+		if (!surya_mdss_map) {
+			return -1;
+		}
+	}
+	return (int)(touch_rd(surya_mdss_map + 0x6b800u, 0xb0) & 0xffffu);
+}
+
+/*
+ * surya 23.10, suryafb=4: page flipping. The pipe vig0 (MDSS + 0x5000) fetches
+ * the panel image from SSPP_SRC0_ADDR (+0x14; the bootloader left 0x9c000000,
+ * its splash buffer). The register is double-buffered: it takes effect at the
+ * next vsync after the pipe's bit is written to CTL0_FLUSH (MDSS + 0x2000,
+ * +0x18), and the hardware clears the bits once latched. Flushed with the pipe
+ * (bit 0), its mixer LM0 (bit 6) and the CTL itself (bit 17), as Linux does
+ * for a plane update (reference/linux-dpu: dpu_hw_sspp.c, dpu_hw_ctl.c).
+ */
+#define SURYA_MDSS_VIG0         0x5000u
+#define SURYA_MDSS_CTL0         0x2000u
+#define SURYA_SSPP_SRC0_ADDR    0x14u
+#define SURYA_CTL_FLUSH         0x18u
+#define SURYA_FLUSH_BITS        ((1u << 0) | (1u << 6) | (1u << 17))
+
+uint32_t surya_mdss_scanout(void);
+int surya_mdss_flip(uint32_t phys);
+int surya_mdss_flip_pending(void);
+
+uint32_t
+surya_mdss_scanout(void)
+{
+	if (surya_panel_line() < 0) {
+		return 0;
+	}
+	return touch_rd(surya_mdss_map + SURYA_MDSS_VIG0, SURYA_SSPP_SRC0_ADDR);
+}
+
+int
+surya_mdss_flip(uint32_t phys)
+{
+	if (surya_panel_line() < 0) {
+		return -1;
+	}
+	touch_wr(surya_mdss_map + SURYA_MDSS_VIG0, SURYA_SSPP_SRC0_ADDR, phys);
+	touch_wr(surya_mdss_map + SURYA_MDSS_CTL0, SURYA_CTL_FLUSH, SURYA_FLUSH_BITS);
+	return 0;
+}
+
+int
+surya_mdss_flip_pending(void)
+{
+	if (!surya_mdss_map) {
+		return 0;
+	}
+	return (touch_rd(surya_mdss_map + SURYA_MDSS_CTL0, SURYA_CTL_FLUSH) & SURYA_FLUSH_BITS) != 0;
+}
+
+/*
+ * CPU clocks, boot-arg suryafreq (wishes/04, step 4). Nothing changes them
+ * otherwise: the bootloader's rows stay. The OSM takes a row number of its
+ * table per core (DCVS_PERF_STATE_DESIRED, +0x920 + 4 n), as Linux's
+ * clk-cpu-osm does from EL1. suryafreq=max asks for the last row of every
+ * table (the table ends where it repeats); suryafreq=S,B,L asks rows S for
+ * the small cluster, B for the big one, L for L3 (-1 keeps one as it is).
+ * Guard: TSENS is read every second; at 85 C or more the bootloader's rows
+ * come back until every sensor is below 70 C again. Reads of the current
+ * requests and the hottest sensor go to the log once a minute.
+ */
+#define FREQ_HOT_C10   850
+#define FREQ_COOL_C10  700
+
+static struct {
+	vm_offset_t base[3];      /* small, big, L3 */
+	unsigned cores[3];
+	int want[3], boot[3][6];
+	bool throttled;
+} sfq;
+
+static int
+freq_last_row(vm_offset_t base)
+{
+	int last = 0;
+	for (unsigned i = 1; i < 40; ++i) {
+		if (touch_rd(base, 0x110u + 32u * i) == touch_rd(base, 0x110u + 32u * (i - 1u))) {
+			break;
+		}
+		last = (int)i;
+	}
+	return last;
+}
+
+static int
+freq_tsens_max(void)
+{
+	int max = -1000;
+	for (unsigned t = 0; t < 2; ++t) {
+		if (!sst.tsens[t]) {
+			continue;
+		}
+		for (unsigned s = 0; s < 16; ++s) {
+			uint32_t v = touch_rd(sst.tsens[t], 0xa0u + 4u * s);
+			if (!(v & (1u << 21))) {
+				continue;
+			}
+			int temp = (int)(v & 0xfffu);
+			if (temp & 0x800) {
+				temp -= 0x1000;
+			}
+			if (temp > max) {
+				max = temp;
+			}
+		}
+	}
+	return max;
+}
+
+static void
+freq_apply(bool boot_rows)
+{
+	static const char *const names[3] = {"small", "big", "L3"};
+	for (unsigned k = 0; k < 3; ++k) {
+		if (!sfq.base[k] || (!boot_rows && sfq.want[k] < 0)) {
+			continue;
+		}
+		for (unsigned c = 0; c < sfq.cores[k]; ++c) {
+			touch_wr(sfq.base[k], 0x920u + 4u * c, (uint32_t)(boot_rows ? sfq.boot[k][c] : sfq.want[k]));
+		}
+		printf("SURYA FREQ: %s cluster -> row %d%s (read back c0 %u)\n", names[k],
+		    boot_rows ? sfq.boot[k][0] : sfq.want[k], boot_rows ? " (bootloader's)" : "",
+		    touch_rd(sfq.base[k], 0x920u));
+	}
+}
+
+static void
+surya_freq_thread(void *arg, wait_result_t result)
+{
+	char spec[32] = "";
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("suryafreq", spec, sizeof(spec));
+	touch_wait(65000);
+	sfq.base[0] = ml_io_map(STAT_OSM_PWR_PA, 0x1400);
+	sfq.base[1] = ml_io_map(STAT_OSM_PERF_PA, 0x1400);
+	sfq.base[2] = ml_io_map(STAT_OSM_L3_PA, 0x1400);
+	sfq.cores[0] = 6;
+	sfq.cores[1] = 2;
+	sfq.cores[2] = 1;
+	if (!sst.tsens[0]) {
+		sst.tsens[0] = ml_io_map(STAT_TSENS0_PA, 0x1000);
+		sst.tsens[1] = ml_io_map(STAT_TSENS1_PA, 0x1000);
+	}
+	for (unsigned k = 0; k < 3; ++k) {
+		if (!sfq.base[k] || !(touch_rd(sfq.base[k], 0) & 1u)) {
+			printf("SURYA FREQ: OSM %u not mapped or not enabled; left alone\n", k);
+			sfq.base[k] = 0;
+			continue;
+		}
+		for (unsigned c = 0; c < sfq.cores[k]; ++c) {
+			sfq.boot[k][c] = (int)touch_rd(sfq.base[k], 0x920u + 4u * c);
+		}
+	}
+	if (strcmp(spec, "max") == 0) {
+		for (unsigned k = 0; k < 3; ++k) {
+			sfq.want[k] = sfq.base[k] ? freq_last_row(sfq.base[k]) : -1;
+		}
+	} else {
+		const char *p = spec;
+		for (unsigned k = 0; k < 3; ++k) {
+			sfq.want[k] = -1;
+			if (*p == '-') {
+				sfq.want[k] = -1;
+				++p;
+				if (*p == '1') {
+					++p;
+				}
+			} else {
+				int v = 0;
+				bool any = false;
+				while (*p >= '0' && *p <= '9') {
+					v = v * 10 + (*p++ - '0');
+					any = true;
+				}
+				sfq.want[k] = any ? (v > 39 ? 39 : v) : -1;
+			}
+			if (*p == ',') {
+				++p;
+			}
+		}
+	}
+	printf("SURYA FREQ: \"%s\" -> rows small %d big %d L3 %d (bootloader: %d %d %d); hot at %d C, cool at %d C\n",
+	    spec, sfq.want[0], sfq.want[1], sfq.want[2], sfq.boot[0][0], sfq.boot[1][0], sfq.boot[2][0],
+	    FREQ_HOT_C10 / 10, FREQ_COOL_C10 / 10);
+	freq_apply(false);
+	unsigned tick = 0;
+	for (;;) {
+		touch_wait(1000);
+		int t = freq_tsens_max();
+		if (!sfq.throttled && t >= FREQ_HOT_C10) {
+			sfq.throttled = true;
+			printf("SURYA FREQ: %d.%d C: back to the bootloader's rows\n", t / 10, t % 10);
+			freq_apply(true);
+		} else if (sfq.throttled && t < FREQ_COOL_C10) {
+			sfq.throttled = false;
+			printf("SURYA FREQ: %d.%d C: requested rows again\n", t / 10, t % 10);
+			freq_apply(false);
+		}
+		if (++tick % 60 == 0) {
+			printf("SURYA FREQ: requests small %u big %u L3 %u, hottest %d.%d C%s\n",
+			    sfq.base[0] ? touch_rd(sfq.base[0], 0x920u) : 0, sfq.base[1] ? touch_rd(sfq.base[1], 0x920u) : 0,
+			    sfq.base[2] ? touch_rd(sfq.base[2], 0x920u) : 0, t / 10, (t < 0 ? -t : t) % 10,
+			    sfq.throttled ? " (throttled)" : "");
+		}
+	}
+}
+
+/*
+ * Memory bandwidth, boot-arg suryaddr=1 (wishes/04, step 5): 70 s after start
+ * the top votes (0x3fff, what Linux's bcm-voter clamps big requests to) for
+ * the RPMh bus clock managers of DDR (MC0), its voltage corner (ACV) and the
+ * system cache (SH0), through sweet_rpmh_bcm_vote() (bsd/dev/sweet_rpmh.c).
+ * Nothing is voted otherwise. Check: the copy speeds of suryastat=1 and the
+ * OSM/PMU numbers before and after.
+ */
+extern int sweet_rpmh_bcm_vote(const char *const *names, unsigned n, uint32_t vote_x, uint32_t vote_y);
+
+static void
+surya_ddr_thread(void *arg, wait_result_t result)
+{
+	static const char *const names[3] = {"MC0", "ACV", "SH0"};
+	(void)arg;
+	(void)result;
+	touch_wait(70000);
+	int err = sweet_rpmh_bcm_vote(names, 3, 0x3fffu, 0x3fffu);
+	printf("SURYA DDR: MC0/ACV/SH0 top votes -> %d\n", err);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
