+/*
+ * surya measurements (bsd/dev/sweet_touch.c, boot-arg suryastat=1): which
+ * processors the scheduler has idle right now, and one processor's cycle
+ * counter against the system counter. Both read-only. The ARM PMUv3 cycle
+ * counter (PMCCNTR_EL0) is free: this kernel's kpc knows Apple PMUs only.
+ */
+unsigned surya_cpu_idle_mask(void);
+int surya_cpu_measure(unsigned cpu, unsigned ms, uint64_t *cycles, uint64_t *ticks, uint64_t *base);
+uint64_t surya_rtclock_base(void);
+
+/* The base this CPU adds to CNTVCT_EL0 (rtclock_base_abstime itself is not
+ * exported; every CPU's cpu_base_timebase is set from it at start). */
+uint64_t
+surya_rtclock_base(void)
+{
+	return getCpuDatap()->cpu_base_timebase;
+}
+
+unsigned
+surya_cpu_idle_mask(void)
+{
+	unsigned mask = 0;
+	for (unsigned i = 0; i < processor_count && i < 32; ++i) {
+		processor_t p = processor_array[i];
+		if (p != PROCESSOR_NULL && p->state == PROCESSOR_IDLE) {
+			mask |= 1u << i;
+		}
+	}
+	return mask;
+}
+
+/*
+ * surya 23.10: suryabig=N binds the thread that hands frames to the panel
+ * (SwapEnd from backboardd: CoreAnimation's render thread, which also
+ * rasterises in software, CA::OGL::SW) to cpu N. All eight cores sit in one
+ * cluster in this kernel, so the scheduler does not tell the Cortex-A76
+ * cores (6, 7) from the Cortex-A55 ones (0-5) and the render thread may run
+ * on a core of a third of the speed. thread_bind asserts a non-realtime
+ * priority, so a realtime thread is only reported.
+ */
+static int surya_big_cpu = -2;          /* -2 not parsed, -1 off */
+
+void surya_bind_render_thread(void);
+
+void
+surya_bind_render_thread(void)
+{
+	thread_t th = current_thread();
+	static int reported;
+
+	if (surya_big_cpu == -2) {
+		int v = -1;
+		if (!PE_parse_boot_argn("suryabig", &v, sizeof(v)) || v < 0 || v > 7) {
+			v = -1;
+		}
+		surya_big_cpu = v;
+	}
+	if (surya_big_cpu < 0 || th->bound_processor != PROCESSOR_NULL) {
+		return;
+	}
+	if (th->sched_mode == TH_MODE_REALTIME || th->sched_pri >= BASEPRI_RTQUEUES) {
+		if (reported++ < 3) {
+			printf("SURYA BIG: frame thread %llu is realtime (pri %d mode %d), not bound\n",
+			    (unsigned long long)thread_tid(th), th->sched_pri, (int)th->sched_mode);
+		}
+		return;
+	}
+	processor_t p = cpu_to_processor(surya_big_cpu);
+	if (p == PROCESSOR_NULL) {
+		return;
+	}
+	int from = th->last_processor ? th->last_processor->cpu_id : -1;
+	(void)thread_bind(p);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+	printf("SURYA BIG: frame thread %llu (pri %d mode %d) bound to cpu %d, was on cpu %d, now on cpu %d\n",
+	    (unsigned long long)thread_tid(th), th->sched_pri, (int)th->sched_mode, surya_big_cpu, from,
+	    cpu_number());
+}
+
+int
+surya_cpu_measure(unsigned cpu, unsigned ms, uint64_t *cycles, uint64_t *ticks, uint64_t *base)
+{
+	if (cpu >= processor_count || processor_array[cpu] == PROCESSOR_NULL) {
+		return -1;
+	}
+	processor_t old = thread_bind(processor_array[cpu]);
+	thread_block(THREAD_CONTINUE_NULL); /* move there now */
+	if (current_processor() != processor_array[cpu]) {
+		thread_bind(old);
+		return -2;
+	}
+	uint64_t pmcr = __builtin_arm_rsr64("PMCR_EL0");
+	__builtin_arm_wsr64("PMCR_EL0", pmcr | 0x5ULL); /* E: enable, C: reset the cycle counter */
+	__builtin_arm_wsr64("PMCNTENSET_EL0", 1ULL << 31);
+	__asm__ volatile ("isb" ::: "memory");
+	uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t t0 = __builtin_arm_rsr64("CNTVCT_EL0");
+	uint64_t c0 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	uint64_t t1 = t0, end = t0 + freq * ms / 1000ULL;
+	while (t1 < end) {
+		t1 = __builtin_arm_rsr64("CNTVCT_EL0");
+	}
+	uint64_t c1 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	__asm__ volatile ("isb" ::: "memory");
+	/* this CPU's mach_absolute_time base: userland uses the commpage's
+	 * rtclock_base_abstime for every CPU, so they must all agree */
+	*base = getCpuDatap()->cpu_base_timebase;
+	thread_bind(old);
+	*cycles = c1 - c0;
+	*ticks = t1 - t0;
+	return 0;
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
 kern_return_t
