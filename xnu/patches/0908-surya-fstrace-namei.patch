sweet: file-system trace for named processes (paths)

A daemon that fails on a missing or broken path logs nothing we can see
(tzinit left /var/db/timezone/zoneinfo absent and exited 0). namei now
prints every lookup of a process named in boot-arg sweetfstrace:
"FS name[pid] namei op N path -> error".
--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -162,6 +162,586 @@
  *		lookup: ???
  *		VNOP_READLINK:???
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/pexpert.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <sys/dirent.h>
+/*
+ * surya: file-system trace for named processes. A daemon that fails on a
+ * missing or broken path (tzinit left /var/db/timezone/zoneinfo absent and
+ * exited 0) logs nothing we can see; this prints every path it looks up and,
+ * from unix_syscall (bsd/dev/arm/systemcalls.c), every system call that fails:
+ *   FS name[pid] namei op N path -> error      (op: 0 lookup, 1 create, 2 delete, 3 rename)
+ *   FS name[pid] syscall N -> error
+ * Boot-arg sweetfstrace: comma separated process names; absent or "-" = off.
+ */
+static char sweet_fstrace_names[128];
+static int sweet_fstrace_state;         /* 0 not parsed, 1 off, 2 on */
+
+bool sweet_fstrace_wanted(proc_t p);
+
+bool
+sweet_fstrace_wanted(proc_t p)
+{
+	if (sweet_fstrace_state == 0) {
+		if (!PE_parse_boot_argn("sweetfstrace", sweet_fstrace_names, sizeof(sweet_fstrace_names)) ||
+		    sweet_fstrace_names[0] == '-' || sweet_fstrace_names[0] == '\0') {
+			sweet_fstrace_state = 1;
+		} else {
+			sweet_fstrace_state = 2;
+		}
+	}
+	if (sweet_fstrace_state != 2 || p == PROC_NULL) {
+		return false;
+	}
+	size_t n = strlen(p->p_comm);
+	for (const char *t = sweet_fstrace_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, p->p_comm, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+/*
+ * surya 24.10: boot-arg sweetlsreset=1 deletes the LaunchServices database
+ * (/private/var/mobile/Containers/Data/InternalDaemon/<uuid>/Library/Caches/
+ * com.apple.LaunchServices*) before launchd starts, so lsd seeds it again. A
+ * database seeded while the extension-point catalog was unreadable keeps every
+ * app extension out for good: lsd reuses it as "seeded" (ry-diffusion/Bergamota
+ * 0106 and docs/EXTENSION_POINTS_2.md; lgrachov/ios-qemu 80bbe28573 — poster
+ * providers and widgets ran only after a fresh seed). Bergamota names its
+ * container's UUID; ours is not known in advance, so every InternalDaemon
+ * container is searched. Goes through HFS+ and its journal. One-shot: boot
+ * without the argument afterwards.
+ */
+extern errno_t vnode_readdir64(struct vnode *vp, struct uio *uio, int flags, int *eofflag,
+    int *numdirent, vfs_context_t ctxp);
+extern int unlink1(vfs_context_t ctx, vnode_t start_dvp, user_addr_t path_arg,
+    enum uio_seg segflg, int unlink_flags);
+void sweet_ls_reset(void);
+
+#define SWEET_LS_CONTAINERS     "/private/var/mobile/Containers/Data/InternalDaemon"
+#define SWEET_LS_MAX_NAMES      64
+
+/* Names in a directory (no dot entries), at most max, each up to 255 bytes. */
+static int
+sweet_dir_names(const char *dir, char (*names)[256], int max, int *count)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t dvp = NULLVP;
+	*count = 0;
+	int error = vnode_lookup(dir, 0, &dvp, ctx);
+	if (error) {
+		return error;
+	}
+	const size_t bufsize = 16384;
+	char *buf = kalloc_data(bufsize, Z_WAITOK);
+	if (buf == NULL) {
+		vnode_put(dvp);
+		return ENOMEM;
+	}
+	off_t off = 0;
+	int eof = 0;
+	for (int pass = 0; !eof && pass < 64 && *count < max; pass++) {
+		uio_t uio = uio_create(1, off, UIO_SYSSPACE, UIO_READ);
+		if (uio == NULL) {
+			error = ENOMEM;
+			break;
+		}
+		uio_addiov(uio, CAST_USER_ADDR_T(buf), bufsize);
+		int numdirent = 0;
+		error = vnode_readdir64(dvp, uio, VNODE_READDIR_EXTENDED, &eof, &numdirent, ctx);
+		size_t got = bufsize - (size_t)uio_resid(uio);
+		off = uio_offset(uio);
+		uio_free(uio);
+		if (error || got == 0) {
+			break;
+		}
+		for (size_t pos = 0; pos + offsetof(struct direntry, d_name) < got && *count < max;) {
+			struct direntry *de = (struct direntry *)(void *)(buf + pos);
+			if (de->d_reclen == 0) {
+				break;
+			}
+			if (de->d_ino != 0 && de->d_namlen > 0 && de->d_name[0] != '.') {
+				size_t n = MIN((size_t)de->d_namlen, (size_t)255);
+				memcpy(names[*count], de->d_name, n);
+				names[*count][n] = '\0';
+				(*count)++;
+			}
+			pos += de->d_reclen;
+		}
+	}
+	kfree_data(buf, bufsize);
+	vnode_put(dvp);
+	return error;
+}
+
+void
+sweet_ls_reset(void)
+{
+	uint32_t on = 0;
+	if (!PE_parse_boot_argn("sweetlsreset", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	char (*uuids)[256] = kalloc_data(SWEET_LS_MAX_NAMES * 256, Z_WAITOK);
+	char (*files)[256] = kalloc_data(SWEET_LS_MAX_NAMES * 256, Z_WAITOK);
+	char *path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (uuids == NULL || files == NULL || path == NULL) {
+		printf("SWEET LS: no memory\n");
+		goto out;
+	}
+	int nu = 0, deleted = 0;
+	int error = sweet_dir_names(SWEET_LS_CONTAINERS, uuids, SWEET_LS_MAX_NAMES, &nu);
+	printf("SWEET LS: %d InternalDaemon containers (error %d)\n", nu, error);
+	for (int i = 0; i < nu; i++) {
+		snprintf(path, MAXPATHLEN, "%s/%s/Library/Caches", SWEET_LS_CONTAINERS, uuids[i]);
+		int nf = 0;
+		if (sweet_dir_names(path, files, SWEET_LS_MAX_NAMES, &nf) != 0) {
+			continue;
+		}
+		for (int j = 0; j < nf; j++) {
+			if (strnstr(files[j], "LaunchServices", sizeof(files[j])) == NULL) {
+				continue;
+			}
+			snprintf(path, MAXPATHLEN, "%s/%s/Library/Caches/%s", SWEET_LS_CONTAINERS, uuids[i], files[j]);
+			error = unlink1(vfs_context_kernel(), NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+			printf("SWEET LS: unlink %s -> %d\n", path, error);
+			deleted += error == 0;
+		}
+	}
+	printf("SWEET LS: %d LaunchServices database files deleted; lsd seeds anew\n", deleted);
+out:
+	if (uuids != NULL) {
+		kfree_data(uuids, SWEET_LS_MAX_NAMES * 256);
+	}
+	if (files != NULL) {
+		kfree_data(files, SWEET_LS_MAX_NAMES * 256);
+	}
+	if (path != NULL) {
+		kfree_data(path, MAXPATHLEN);
+	}
+}
+
+/*
+ * surya 25.10: boot-arg sweetwallreset=1 deletes the legacy wallpaper files
+ * /private/var/mobile/Library/SpringBoard/{Lock,Home}Background{.cpbitmap,.jpg,
+ * Thumbnail.jpg} before launchd starts. Root v3 (23.10) put a JPEG there,
+ * also under the .cpbitmap name (a raw Apple format). Once app extensions ran
+ * (shim-xr22), LegacyPoster used them and PaperBoardUI's snapshot of that
+ * poster got no CGImage: SpringBoard died in _UIImageGetCGImageRepresentation
+ * (-[PBUIImageEncoder saveUIImage:error:]) every few seconds. One-shot.
+ */
+/*
+ * surya 25.10: files the boot image carries for the iOS root (mkpayload.py
+ * --files MANIFEST; idea from the spes and sunstone ports, written anew):
+ * changing the root no longer needs a 10-minute userdata flash, only
+ * `fastboot boot`. The archive is at /chosen/memory-map "SuryaFiles" =
+ * <phys, size>, installed once launchd is about to start (kern_exec.c):
+ *   char magic[8] = "SURYAFS1"; u32 version = 1, count;
+ *   count x { u32 op, mode, uid, gid, path_len (with NUL), pad; u64 size;
+ *             path, data — each padded to 8 bytes }
+ *   op 1: put a file (written only when missing or different; the size is
+ *         set exactly afterwards — vnode_open with O_TRUNC does not always
+ *         truncate, which corrupted a launchd.plist in another port);
+ *   op 2: delete a file; op 3: make a directory; op 4: delete a directory
+ *         tree (only below /private/var/); op 5: print a tree into the log
+ *         (mode = depth, default 3).
+ * Parent directories of a put are made as needed (mode 0755, root:wheel).
+ * Owner and mode are set on every put and mkdir. Boot-arg suryafiles=0 skips.
+ */
+#include <pexpert/device_tree.h>
+extern uint64_t phystokv(uint64_t pa);          /* osfmk/arm/pmap (vm_map_address_t, pmap_paddr_t) */
+void surya_files_install(void);
+
+#define SURYA_FILES_CHUNK       65536u
+
+static int
+surya_mkdir(const char *path, uint32_t mode, vfs_context_t ctx)
+{
+	struct nameidata nd;
+	struct vnode_attr va;
+	vnode_t vp, dvp;
+
+	NDINIT(&nd, CREATE, OP_MKDIR, LOCKPARENT | AUDITVNPATH1, UIO_SYSSPACE,
+	    CAST_USER_ADDR_T(path), ctx);
+	nd.ni_cnd.cn_flags |= WILLBEDIR;
+	int error = namei(&nd);
+	if (error) {
+		return error;
+	}
+	dvp = nd.ni_dvp;
+	vp = nd.ni_vp;
+	if (vp == NULLVP) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_type, VDIR);
+		VATTR_SET(&va, va_mode, mode & 07777);
+		error = vn_create(dvp, &vp, &nd, &va, 0, 0, NULL, ctx);
+	} else {
+		error = EEXIST;
+	}
+	nameidone(&nd);
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	return error;
+}
+
+static void
+surya_mkparents(const char *path, vfs_context_t ctx)
+{
+	char *dir = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (dir == NULL) {
+		return;
+	}
+	size_t len = strnlen(path, MAXPATHLEN - 1);
+	for (size_t i = 1; i < len; i++) {
+		if (path[i] == '/') {
+			memcpy(dir, path, i);
+			dir[i] = '\0';
+			(void)surya_mkdir(dir, 0755, ctx);      /* EEXIST for those that are there */
+		}
+	}
+	kfree_data(dir, MAXPATHLEN);
+}
+
+static int
+surya_set_owner(const char *path, uint32_t mode, uint32_t uid, uint32_t gid, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	VATTR_SET(&va, va_uid, uid);
+	VATTR_SET(&va, va_gid, gid);
+	error = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return error;
+}
+
+static bool
+surya_same(const char *path, const uint8_t *data, uint64_t size, vfs_context_t ctx, uint8_t *buf)
+{
+	vnode_t vp = NULLVP;
+	off_t cur = 0;
+	if (vnode_open(path, FREAD, 0, 0, &vp, ctx) != 0) {
+		return false;
+	}
+	bool same = vnode_size(vp, &cur, ctx) == 0 && (uint64_t)cur == size;
+	for (uint64_t off = 0; same && off < size; off += SURYA_FILES_CHUNK) {
+		int n = (int)MIN((uint64_t)SURYA_FILES_CHUNK, size - off), resid = 0;
+		if (vn_rdwr(UIO_READ, vp, (caddr_t)buf, n, (off_t)off, UIO_SYSSPACE, IO_NODELOCKED,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx)) != 0 || resid != 0 ||
+		    memcmp(buf, data + off, (size_t)n) != 0) {
+			same = false;
+		}
+	}
+	(void)vnode_close(vp, FREAD, ctx);
+	return same;
+}
+
+static int
+surya_put(const char *path, const uint8_t *data, uint64_t size, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	surya_mkparents(path, ctx);
+	int error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, 0644, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	for (uint64_t off = 0; error == 0 && off < size; off += SURYA_FILES_CHUNK) {
+		int n = (int)MIN((uint64_t)SURYA_FILES_CHUNK, size - off), resid = 0;
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)(data + off), n, (off_t)off,
+		    UIO_SYSSPACE, IO_NODELOCKED | IO_SYNC, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0) {
+			error = EIO;
+		}
+	}
+	if (error == 0) {
+		error = vnode_setsize(vp, (off_t)size, IO_SYNC, ctx);
+	}
+	(void)vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+/* op 4 (rmtree) and op 5 (list): directories, walked with sweet_dir_names (readdir). */
+static int
+surya_rmdir(const char *path, vfs_context_t ctx)
+{
+	struct nameidata nd;
+	NDINIT(&nd, DELETE, OP_RMDIR, LOCKPARENT | AUDITVNPATH1, UIO_SYSSPACE,
+	    CAST_USER_ADDR_T(path), ctx);
+	int error = namei(&nd);
+	if (error) {
+		return error;
+	}
+	vnode_t vp = nd.ni_vp, dvp = nd.ni_dvp;
+	if (vp == NULLVP) {
+		error = ENOENT;
+	} else if (vnode_vtype(vp) != VDIR) {
+		error = ENOTDIR;
+	} else if (vp == dvp || vnode_isvroot(vp)) {
+		error = EBUSY;
+	} else {
+		error = VNOP_RMDIR(dvp, vp, &nd.ni_cnd, ctx);
+	}
+	nameidone(&nd);
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	return error;
+}
+
+#define SURYA_TREE_NAMES        256
+
+/* Delete everything under path, then path; depth-first, at most 16 levels. */
+static int
+surya_rmtree(const char *path, int depth, vfs_context_t ctx, unsigned *count)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	bool dir = vnode_vtype(vp) == VDIR;
+	vnode_put(vp);
+	if (!dir) {
+		error = unlink1(ctx, NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+		*count += error == 0;
+		return error;
+	}
+	if (depth > 16) {
+		return ELOOP;
+	}
+	char (*names)[256] = kalloc_data(SURYA_TREE_NAMES * 256, Z_WAITOK);
+	char *child = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (names == NULL || child == NULL) {
+		error = ENOMEM;
+		goto out;
+	}
+	for (int pass = 0; pass < 64; pass++) {
+		int n = 0;
+		(void)sweet_dir_names(path, names, SURYA_TREE_NAMES, &n);
+		if (n == 0) {
+			break;
+		}
+		for (int i = 0; i < n; i++) {
+			snprintf(child, MAXPATHLEN, "%s/%s", path, names[i]);
+			(void)surya_rmtree(child, depth + 1, ctx, count);
+		}
+	}
+	error = surya_rmdir(path, ctx);
+	*count += error == 0;
+out:
+	if (names != NULL) {
+		kfree_data(names, SURYA_TREE_NAMES * 256);
+	}
+	if (child != NULL) {
+		kfree_data(child, MAXPATHLEN);
+	}
+	return error;
+}
+
+/* Print the tree under path (names, sizes) into the log; at most depth levels. */
+static void
+surya_list(const char *path, int depth, int max_depth, vfs_context_t ctx, unsigned *lines)
+{
+	vnode_t vp = NULLVP;
+	if (*lines > 400 || vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx) != 0) {
+		return;
+	}
+	bool dir = vnode_vtype(vp) == VDIR;
+	off_t size = 0;
+	(void)vnode_size(vp, &size, ctx);
+	vnode_put(vp);
+	printf("SURYA FILES: ls %s%s (%lld)\n", path, dir ? "/" : "", (long long)size);
+	(*lines)++;
+	if (!dir || depth >= max_depth) {
+		return;
+	}
+	char (*names)[256] = kalloc_data(SURYA_TREE_NAMES * 256, Z_WAITOK);
+	char *child = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	int n = 0;
+	if (names != NULL && child != NULL) {
+		(void)sweet_dir_names(path, names, SURYA_TREE_NAMES, &n);
+		for (int i = 0; i < n; i++) {
+			snprintf(child, MAXPATHLEN, "%s/%s", path, names[i]);
+			surya_list(child, depth + 1, max_depth, ctx, lines);
+		}
+	}
+	if (names != NULL) {
+		kfree_data(names, SURYA_TREE_NAMES * 256);
+	}
+	if (child != NULL) {
+		kfree_data(child, MAXPATHLEN);
+	}
+}
+
+void
+surya_files_install(void)
+{
+	DTEntry entry;
+	void const *prop = NULL;
+	unsigned int prop_size = 0;
+	uint32_t on = 1;
+
+	(void)PE_parse_boot_argn("suryafiles", &on, sizeof(on));
+	if (!on || SecureDTLookupEntry(NULL, "/chosen/memory-map", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "SuryaFiles", &prop, &prop_size) != kSuccess || prop_size < 16) {
+		return;
+	}
+	uint64_t pa = ((const uint64_t *)prop)[0], len = ((const uint64_t *)prop)[1];
+	const uint8_t *base = (const uint8_t *)(uintptr_t)phystokv(pa), *end = base + len;
+	if (len < 16 || memcmp(base, "SURYAFS1", 8) != 0 || *(const uint32_t *)(base + 8) != 1) {
+		printf("SURYA FILES: bad archive at 0x%llx (%llu bytes)\n", pa, len);
+		return;
+	}
+	uint32_t count = *(const uint32_t *)(base + 12);
+	const uint8_t *p = base + 16;
+	vfs_context_t ctx = vfs_context_kernel();
+	uint8_t *buf = kalloc_data(SURYA_FILES_CHUNK, Z_WAITOK);
+	unsigned done = 0, kept = 0, failed = 0;
+
+	for (uint32_t i = 0; i < count && buf != NULL; i++) {
+		if (end - p < 32) {
+			printf("SURYA FILES: archive ends early at entry %u\n", i);
+			break;
+		}
+		const uint32_t *h = (const uint32_t *)p;
+		uint32_t op = h[0], mode = h[1], uid = h[2], gid = h[3], path_len = h[4];
+		uint64_t size = *(const uint64_t *)(p + 24);
+		const char *path = (const char *)(p + 32);
+		const uint8_t *data = p + 32 + ((path_len + 7u) & ~7u);
+		if (path_len < 2 || path_len > 1023 || path[path_len - 1] != '\0' || path[0] != '/' ||
+		    data > end || (uint64_t)(end - data) < size) {
+			printf("SURYA FILES: entry %u malformed; stopping\n", i);
+			break;
+		}
+		p = data + ((size + 7u) & ~7ull);
+		int error = 0;
+		const char *what = "?";
+		switch (op) {
+		case 1:
+			if (surya_same(path, data, size, ctx, buf)) {
+				kept++;
+				(void)surya_set_owner(path, mode, uid, gid, ctx);
+				continue;
+			}
+			what = "put";
+			error = surya_put(path, data, size, ctx);
+			if (error == 0) {
+				error = surya_set_owner(path, mode, uid, gid, ctx);
+			}
+			break;
+		case 2:
+			what = "rm";
+			error = unlink1(ctx, NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+			if (error == ENOENT) {
+				kept++;
+				continue;
+			}
+			break;
+		case 3:
+			what = "mkdir";
+			surya_mkparents(path, ctx);
+			error = surya_mkdir(path, mode, ctx);
+			if (error == EEXIST) {
+				error = 0;
+			}
+			if (error == 0) {
+				error = surya_set_owner(path, mode, uid, gid, ctx);
+			}
+			break;
+		case 4:
+			/* only below /private/var/: user data, never the system volume */
+			what = "rmtree";
+			if (strncmp(path, "/private/var/", 13) != 0 || strstr(path, "/..") != NULL) {
+				error = EPERM;
+				break;
+			}
+			{
+				unsigned removed = 0;
+				error = surya_rmtree(path, 0, ctx, &removed);
+				printf("SURYA FILES: rmtree %s: %u removed\n", path, removed);
+			}
+			if (error == ENOENT) {
+				kept++;
+				continue;
+			}
+			break;
+		case 5:
+			{
+				unsigned lines = 0;
+				surya_list(path, 0, (int)(mode ? mode : 3), ctx, &lines);
+			}
+			continue;
+		default:
+			printf("SURYA FILES: entry %u: unknown op %u\n", i, op);
