surya: foreground threads take an idle Cortex-A76 core first

From Yofuness/ios-flame branch sunfish, patch 0147 (Pixel 4a, same SM7150):
the ADT describes one SMP cluster, so the scheduler does not tell the two
A76 cores (6, 7) from the six A55s. In choose_processor(), a thread at
BASEPRI_FOREGROUND or above takes an idle CPU 7 or 6 first (there:
backboardd 18 -> 30-34 frame submissions a second). Boot-arg sweetbig=0: off.
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -5055,6 +5055,31 @@
 		}
 	}
 
+#if defined(__arm64__)
+	/*
+	 * sunfish (0147): the ADT describes one SMP cluster, but CPUs 6-7 are the A76 big cores (6 x A55 + 2 x A76).
+	 * Foreground and UI threads (render server, apps) take an idle big core first. Boot-arg sweetbig=0: off.
+	 */
+	{
+		static int sweet_big = -1;
+		if (sweet_big < 0) {
+			int v = 1;
+			PE_parse_boot_argn("sweetbig", &v, sizeof(v));
+			sweet_big = v;
+		}
+		if (sweet_big && thread->sched_pri >= BASEPRI_FOREGROUND) {
+			for (int i = 7; i >= 6; i--) {
+				processor_t bp = processor_array[i];
+				if (bp != PROCESSOR_NULL && bp->processor_set == pset && bp->state == PROCESSOR_IDLE &&
+				    bp->is_recommended) {
+					processor = bp;
+					break;
+				}
+			}
+		}
+	}
+#endif
+
